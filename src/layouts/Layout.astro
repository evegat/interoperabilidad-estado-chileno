---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Observatorio de Interoperabilidad del Estado Chileno · Eduardo Vega Toledo (evegat.cl)',
  description = 'Observatorio interactivo de grafo y dataset estructurado de la interoperabilidad del Estado de Chile: flujos interinstitucionales, PISEE, ClaveÚnica, APIs y brechas normativas. Por Eduardo Vega Toledo.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-[#041a37]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Eduardo Vega Toledo" />
    <meta name="theme-color" content="#041a37" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://interoperabilidadpublica.evegat.cl/" />
    <meta property="og:title" content="Observatorio de Interoperabilidad del Estado Chileno (Ley 21.180 · DS N° 12/2023)" />
    <meta property="og:description" content="Observatorio interactivo de 84 organismos públicos y 105 flujos interinstitucionales: Red de Nodos PISEE 2.0, Nivel de Conexión Digital (0–100%), Sello Agent-Ready, Ley 21.719 de Datos Personales y Ley 21.663 de Ciberseguridad. Por Eduardo Vega Toledo (evegat.cl)." />
    <meta property="og:site_name" content="Laboratorio GovTech · Eduardo Vega Toledo (evegat.cl)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Observatorio de Interoperabilidad del Estado Chileno · Eduardo Vega Toledo" />
    <meta name="twitter:description" content="Auditoría interactiva de 84 organismos públicos, 105 flujos de datos y matriz de brechas críticas bajo el DS N° 12/2023, Ley N° 21.180 y Ley N° 21.719." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="h-full bg-[#041a37] text-[#f1f5f9] antialiased overflow-hidden flex flex-col font-sans selection:bg-[#d7653b] selection:text-white">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --brand-deep: #041a37;
    --brand-deep-2: #0b4aa2;
    --brand-ink: #13201e;
    --brand-paper: #f7f5ef;
    --brand-soft: #f1f5f9;
    --brand-muted: #94a3b8;
    --brand-accent: #d7653b;
    --brand-mint: #54b995;
    --brand-gold: #c5a75a;
  }

  /* Custom scrollbar matching evegat.cl deep pine */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #031329;
  }
  ::-webkit-scrollbar-thumb {
    background: #0b4aa2;
    border-radius: 3px;
    border: 1px solid #1e3a5f;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #1d4d91;
  }
</style>
