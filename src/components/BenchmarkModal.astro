---
---

<div
  id="benchmark-modal"
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="benchmark-modal-title"
>
  <div class="bg-[#081d1a] border border-[#163a34] rounded-2xl max-w-4xl w-full max-h-[88vh] overflow-y-auto shadow-2xl p-6 sm:p-7 text-[#8fafaa]">
    <!-- Modal Header -->
    <div class="flex items-start justify-between pb-4 border-b border-[#163a34] mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#54b995] bg-[#12483f] px-2 py-0.5 rounded border border-[#1e5a4f]">
            Benchmark Arquitectónico Comparado
          </span>
          <span class="text-[10px] font-mono text-[#e4b18e] bg-[#d7653b]/20 px-2 py-0.5 rounded border border-[#d7653b]/30">
            Ley N° 21.180 vs Estándares Globales
          </span>
        </div>
        <h2 id="benchmark-modal-title" class="text-xl font-black text-white tracking-tight flex items-center gap-2">
          Benchmark Global de Interoperabilidad Pública
        </h2>
        <p class="text-xs text-[#8fafaa] mt-1">
          Comparativa técnica entre la arquitectura de interoperabilidad del Estado de Chile (SGD / PISEE 2.0) y referentes mundiales de interoperabilidad pública.
        </p>
      </div>
      <button
        id="btn-close-benchmark"
        type="button"
        class="text-[#8fafaa] hover:text-white p-1.5 rounded-lg hover:bg-[#12483f] transition-colors focus:outline-none"
        title="Cerrar modal"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Comparative Grid -->
    <div class="space-y-5 text-xs">
      <!-- 🇪🇪 Estonia -->
      <div class="p-5 rounded-xl bg-[#051311] border border-[#163a34] hover:border-[#1e5a4f] transition-all">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
          <h3 class="font-bold text-sm text-[#54b995] flex items-center gap-2">
            <span class="text-lg">🇪🇪</span>
            <span>Estonia — X-Road (X-tee) & RIHA</span>
          </h3>
          <span class="px-2.5 py-0.5 rounded-full bg-[#12483f] text-[#54b995] border border-[#1e5a4f] text-[10px] font-mono font-bold">
            Peer-to-Peer Distribuido / Federado
          </span>
        </div>
        <p class="text-[#e9efec] leading-relaxed">
          Red distribuida donde cada organismo monta un <em>Security Server</em> certificado. No existe un bus central que almacene o concentre el tráfico de datos: las peticiones viajan cifradas punto a punto entre agencias, validadas con firmas digitales X.509 y sellos de tiempo inmutables. Dispone del <strong>X-Road Visualizer</strong> para monitoreo de tráfico en vivo y el catálogo <strong>RIHA</strong> que actúa como registro unificado de esquemas y ontologías de datos del Estado.
        </p>
        <div class="mt-3 p-3 rounded-lg bg-[#081d1a] border border-[#163a34] text-[11px] leading-relaxed">
          <strong class="text-[#f7f5ef] block mb-0.5">Contraste con Chile (SGD / PISEE):</strong>
          Chile adoptó históricamente una arquitectura orientada a servicios centralizada en la Secretaría de Gobierno Digital (Ministerio de Hacienda). Mientras Estonia eliminó el concentrador central para evitar puntos únicos de falla (SPOF) y cuellos de botella de red, Chile mantiene el bus PISEE como nodo orquestador e intermediario de trazabilidad de la Ley N° 21.180.
        </div>
      </div>

      <!-- 🇸🇬 Singapur -->
      <div class="p-5 rounded-xl bg-[#051311] border border-[#163a34] hover:border-[#1e5a4f] transition-all">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
          <h3 class="font-bold text-sm text-[#38bdf8] flex items-center gap-2">
            <span class="text-lg">🇸🇬</span>
            <span>Singapur — APEX (API Exchange) & Singpass</span>
          </h3>
          <span class="px-2.5 py-0.5 rounded-full bg-[#0369a1]/20 text-[#38bdf8] border border-[#0369a1]/40 text-[10px] font-mono font-bold">
            API Gateway Centralizado & GovTech Cloud
          </span>
        </div>
        <p class="text-[#e9efec] leading-relaxed">
          Plataforma centralizada bajo la iniciativa <em>Smart Nation</em> operada por GovTech Singapore. APEX provee un catálogo unificado de APIs RESTful y streaming en tiempo real con autenticación mTLS, políticas automáticas de throttling, rate limiting y control fino de accesos por ámbito de datos. Se articula nativamente con <em>Singpass</em> para federación de identidad de 4.5+ millones de ciudadanos y autenticación con biometría móvil.
        </p>
        <div class="mt-3 p-3 rounded-lg bg-[#081d1a] border border-[#163a34] text-[11px] leading-relaxed">
          <strong class="text-[#f7f5ef] block mb-0.5">Contraste con Chile (SGD / PISEE):</strong>
          El modelo de Singapur es el más cercano conceptualmente a la visión de PISEE 2.0 y ClaveÚnica en Chile, pero Singapur cuenta con una capa madura de observabilidad nativa en la nube (GovTech Cloud), SLAs con penalizaciones y un portal de desarrolladores con sandboxes interactivos inmediatos para agencias y sector privado regulado.
        </div>
      </div>

      <!-- 🇪🇺 Unión Europea -->
      <div class="p-5 rounded-xl bg-[#051311] border border-[#163a34] hover:border-[#1e5a4f] transition-all">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
          <h3 class="font-bold text-sm text-[#c084fc] flex items-center gap-2">
            <span class="text-lg">🇪🇺</span>
            <span>Unión Europea — EIF & EIRA / Joinup</span>
          </h3>
          <span class="px-2.5 py-0.5 rounded-full bg-[#6b21a8]/20 text-[#c084fc] border border-[#6b21a8]/40 text-[10px] font-mono font-bold">
            Marco de 4 Capas (EIF / Interoperable Europe Act)
          </span>
        </div>
        <p class="text-[#e9efec] leading-relaxed">
          El Marco Europeo de Interoperabilidad (EIF) y la reciente Ley de Europa Interoperable estructuran el intercambio transfronterizo en 4 capas estrictas: <strong>Jurídica</strong> (Directiva NIS2, RGPD), <strong>Organizacional</strong> (procesos y acuerdos de nivel de servicio comunes), <strong>Semántica</strong> (Core Vocabularies, DCAT-AP, ontologías) y <strong>Técnica</strong> (especificaciones abiertas y protocolos estándar). La plataforma comunitaria <em>Joinup</em> y la herramienta <em>CarTool</em> permiten mapear los <em>Building Blocks</em> de cada Estado miembro.
        </p>
        <div class="mt-3 p-3 rounded-lg bg-[#081d1a] border border-[#163a34] text-[11px] leading-relaxed">
          <strong class="text-[#f7f5ef] block mb-0.5">Contraste con Chile (SGD / PISEE):</strong>
          El marco legal chileno bajo la Ley N° 21.180 y la Norma Técnica de Interoperabilidad (Decreto Supremo N° 4/2021 Segpres) adoptó formalmente la taxonomía europea de las 4 capas. Sin embargo, la mayor brecha de Chile radica hoy en la capa semántica: no existe un diccionario de datos ni vocabularios ontológicos obligatorios entre ministerios, lo que perpetúa la heterogeneidad de formatos de fecha, RUN y tipologías registrales.
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="mt-6 pt-4 border-t border-[#163a34] flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="text-[11px] text-[#8fafaa]">
        Investigación desarrollada para <a href="https://evegat.cl" target="_blank" rel="noopener noreferrer" class="text-[#54b995] font-bold hover:underline">evegat.cl</a> · interoperabilidadpublica.evegat.cl
      </span>
      <button
        id="btn-close-benchmark-footer"
        type="button"
        class="px-4 py-2 bg-[#12483f] hover:bg-[#1a5e52] text-[#f7f5ef] hover:text-white rounded-lg font-bold text-xs border border-[#235d52] hover:border-[#54b995] transition-colors focus:outline-none"
      >
        Entendido, Volver al Mapa
      </button>
    </div>
  </div>
</div>

<script>
  function initBenchmarkModal() {
    const modal = document.getElementById('benchmark-modal');
    const openBtn = document.getElementById('btn-benchmark');
    const closeBtn = document.getElementById('btn-close-benchmark');
    const footerCloseBtn = document.getElementById('btn-close-benchmark-footer');

    function openModal() {
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    footerCloseBtn?.addEventListener('click', closeModal);

    // Close on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initBenchmarkModal);
    } else {
      initBenchmarkModal();
    }
  }
</script>
