---
import { TIPOLOGIA_CONFIG, PROTOCOLO_CONFIG } from '../lib/graph-styles.js';
import type { TipoNodo, EstandarProtocolo } from '../types/interoperabilidad.js';

const tipologias = Object.entries(TIPOLOGIA_CONFIG) as [TipoNodo, (typeof TIPOLOGIA_CONFIG)[TipoNodo]][];
const protocolos = Object.entries(PROTOCOLO_CONFIG) as [EstandarProtocolo, (typeof PROTOCOLO_CONFIG)[EstandarProtocolo]][];
---

<div class="bg-[#06234a]/95 backdrop-blur border-b border-[#1e3a5f] px-4 sm:px-6 py-2 text-xs text-[#94a3b8]">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row lg:items-center lg:justify-between gap-2.5">
    
    <!-- Primary Filters: Canales Oficiales y Niveles de Madurez -->
    <div class="flex flex-wrap items-center gap-3">
      <!-- Channel Filter (PISEE, Bilateral, Manual) -->
      <div class="flex items-center space-x-1.5">
        <span class="font-bold text-[#94a3b8] text-[11px] uppercase tracking-wider flex items-center gap-1">
          Canal:
        </span>
        <div class="inline-flex rounded-lg bg-[#041a37] p-0.5 border border-[#1e3a5f]" id="filter-channel-group">
          <button
            type="button"
            data-filter="channel"
            data-value="all"
            class="channel-btn px-2.5 py-1 rounded-md bg-[#0b4aa2] text-white font-bold text-xs transition-colors"
          >
            Todos
          </button>
          <button
            type="button"
            data-filter="channel"
            data-value="PISEE"
            class="channel-btn px-2.5 py-1 rounded-md text-[#54b995] hover:text-white font-medium text-xs transition-colors flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#54b995]"></span>
            PISEE (Oficial)
          </button>
          <button
            type="button"
            data-filter="channel"
            data-value="Convenio"
            class="channel-btn px-2.5 py-1 rounded-md text-[#38bdf8] hover:text-white font-medium text-xs transition-colors flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
            Bilateral
          </button>
          <button
            type="button"
            data-filter="channel"
            data-value="Manual"
            class="channel-btn px-2.5 py-1 rounded-md text-[#c5a75a] hover:text-white font-medium text-xs transition-colors flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[#c5a75a]"></span>
            Manual / Oficio
          </button>
        </div>
      </div>

      <!-- Maturity Filter (Realtime, Batch, Manual) -->
      <div class="flex items-center space-x-1.5">
        <span class="font-bold text-[#94a3b8] text-[11px] uppercase tracking-wider flex items-center gap-1">
          Madurez:
        </span>
        <div class="inline-flex rounded-lg bg-[#041a37] p-0.5 border border-[#1e3a5f]" id="filter-maturity-group">
          <button
            type="button"
            data-filter="maturity"
            data-value="all"
            class="maturity-btn px-2.5 py-1 rounded-md bg-[#0b4aa2] text-white font-bold text-xs transition-colors"
          >
            Todas
          </button>
          <button
            type="button"
            data-filter="maturity"
            data-value="realtime"
            class="maturity-btn px-2.5 py-1 rounded-md text-[#94a3b8] hover:text-white font-medium text-xs transition-colors"
          >
            ⚡ API Tiempo Real
          </button>
          <button
            type="button"
            data-filter="maturity"
            data-value="batch"
            class="maturity-btn px-2.5 py-1 rounded-md text-[#94a3b8] hover:text-white font-medium text-xs transition-colors"
          >
            📦 Lotes / SFTP
          </button>
          <button
            type="button"
            data-filter="maturity"
            data-value="manual"
            class="maturity-btn px-2.5 py-1 rounded-md text-[#94a3b8] hover:text-white font-medium text-xs transition-colors"
          >
            📄 Documental
          </button>
        </div>
      </div>
    </div>

    <!-- Secondary Controls: Typology, Protocol, Gaps & Reset -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Typology Pills (responsive wrap) -->
      <div id="filter-typology" class="flex flex-wrap items-center gap-1">
        <span class="font-bold text-[#94a3b8] mr-0.5 text-[11px] uppercase tracking-wider">Tipo:</span>
        {tipologias.map(([tipo, meta]) => (
          <label
            class="cursor-pointer select-none inline-flex items-center space-x-1 px-2 py-0.5 rounded-full text-[11px] font-semibold border transition-all bg-[#041a37]/80 border-[#1e3a5f] hover:border-[#54b995] text-[#f1f5f9] has-[:checked]:bg-[#0b4aa2] has-[:checked]:border-[#54b995] has-[:checked]:text-white shadow-sm"
          >
            <input
              type="checkbox"
              value={tipo}
              data-filter="typology"
              class="sr-only"
            />
            <span
              class="w-1.5 h-1.5 rounded-full inline-block"
              style={`background-color: ${meta.color};`}
            ></span>
            <span>{meta.label}</span>
          </label>
        ))}
      </div>

      <!-- Protocol Select -->
      <div class="flex items-center space-x-1.5">
        <label for="filter-protocol" class="font-bold text-[#94a3b8] text-[11px] uppercase tracking-wider">Estándar:</label>
        <select
          id="filter-protocol"
          data-filter="protocol"
          class="bg-[#041a37] border border-[#1e3a5f] rounded-md px-2 py-1 text-xs text-[#f7f5ef] focus:outline-none focus:ring-1 focus:ring-[#d7653b]"
        >
          <option value="">Todos los protocolos</option>
          {protocolos.map(([proto, meta]) => (
            <option value={proto}>{meta.label}</option>
          ))}
        </select>
      </div>

      <!-- Eje Temático / Procesos Vitales Filter -->
      <div class="flex items-center space-x-1.5">
        <label for="filter-theme" class="font-bold text-[#94a3b8] text-[11px] uppercase tracking-wider flex items-center gap-1">
          <span>🎯 Proceso Vital:</span>
        </label>
        <select
          id="filter-theme"
          data-filter="theme"
          class="bg-[#041a37] border border-[#1e3a5f] rounded-md px-2 py-1 text-xs text-[#f7f5ef] font-semibold focus:outline-none focus:ring-1 focus:ring-[#38bdf8]"
        >
          <option value="all">Todos los procesos vitales</option>
          <option value="identidad_ciudadana">🆔 Identidad y ClaveÚnica</option>
          <option value="educacion_becas">🎓 Educación, Becas y PAES</option>
          <option value="salud_seguridad_social">🏥 Salud y Licencias Médicas</option>
          <option value="vivienda_urbanismo">🏠 Vivienda, Subsidios y Bienes Raíces</option>
          <option value="trabajo_pensiones">💼 Trabajo, PGU y Cesantía</option>
          <option value="proteccion_social">👥 Protección Social y RSH</option>
          <option value="finanzas_tributario">💰 Impuestos, Renta y Pymes</option>
          <option value="justicia_seguridad">⚖️ Justicia, Alimentos y Fronteras</option>
          <option value="transporte_movilidad">🚗 Transporte y Permisos de Circulación</option>
        </select>
      </div>

      <!-- Conexión Digital Filter -->
      <div class="flex items-center space-x-1.5">
        <label for="filter-imi" class="font-bold text-[#94a3b8] text-[11px] uppercase tracking-wider">Conexión Digital:</label>
        <select
          id="filter-imi"
          data-filter="imi"
          class="bg-[#041a37] border border-[#1e3a5f] rounded-md px-2 py-1 text-xs text-[#f7f5ef] focus:outline-none focus:ring-1 focus:ring-[#54b995]"
        >
          <option value="all">Todos los niveles (1-5)</option>
          <option value="5">Nivel 5: 100% Digital / Cero Papel (81–100%)</option>
          <option value="4">Nivel 4: Conectado por API (61–80%)</option>
          <option value="3">Nivel 3: Conexión Básica (41–60%)</option>
          <option value="2">Nivel 2: Trámite Manual / SFTP (21–40%)</option>
          <option value="1">Nivel 1: Silo / Papel (0–20%)</option>
        </select>
      </div>

      <!-- Only Gaps Toggle -->
      <label class="cursor-pointer select-none inline-flex items-center space-x-1.5 bg-[#041a37] border border-[#1e3a5f] hover:border-[#d7653b] px-2.5 py-1 rounded-md text-xs font-bold text-[#94a3b8] hover:text-[#f7f5ef] transition-colors has-[:checked]:border-[#d7653b] has-[:checked]:bg-[#d7653b]/20 has-[:checked]:text-[#f4dfd5]">
        <input
          type="checkbox"
          id="filter-gaps"
          data-filter="onlyGaps"
          class="w-3.5 h-3.5 text-[#d7653b] rounded bg-[#041a37] border-[#1e3a5f] focus:ring-[#d7653b]"
        />
        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-[#d7653b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Solo con brechas
        </span>
      </label>

      <!-- Reset Filters Button -->
      <button
        type="button"
        id="reset-filters"
        data-action="reset-filters"
        class="inline-flex items-center space-x-1 px-2.5 py-1 bg-[#0b4aa2] hover:bg-[#1d4d91] text-[#f7f5ef] hover:text-white rounded-md border border-[#1d4d91] hover:border-[#d7653b] font-bold text-xs transition-colors focus:outline-none focus:ring-1 focus:ring-[#d7653b]"
        title="Restablecer todos los filtros y búsqueda"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Restablecer</span>
      </button>

      <!-- View Switcher (Grafo vs Matriz de Brechas) -->
      <button
        type="button"
        id="btn-toggle-view"
        class="inline-flex items-center space-x-1.5 px-3 py-1 bg-[#d7653b] hover:bg-[#c95631] text-white rounded-md font-black text-xs transition-all shadow-md focus:outline-none"
        title="Alternar entre Vista de Grafo Interactivo y Vista de Matriz de Brechas"
      >
        <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span>Matriz de Brechas</span>
      </button>
    </div>
  </div>
</div>
