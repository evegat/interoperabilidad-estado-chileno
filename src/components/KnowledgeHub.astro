<script>
  function initKnowledgeHub() {
    const modal = document.getElementById('knowledge-hub-modal');
    const openBtn = document.getElementById('btn-knowledge-hub');
    const closeBtn = document.getElementById('btn-close-knowledge-hub');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.kh-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.kh-panel');

    function openModal() {
      if (!modal) return;
      const guideModal = document.getElementById('guide-modal');
      const benchmarkModal = document.getElementById('benchmark-modal');
      if (guideModal && !guideModal.classList.contains('hidden')) {
        guideModal.classList.add('hidden');
      }
      if (benchmarkModal && !benchmarkModal.classList.contains('hidden')) {
        benchmarkModal.classList.add('hidden');
      }
      modal.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    window.addEventListener('open-knowledge-hub', openModal);

    // Tab switcher with ARIA attribute updates
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.dataset.khTab;
        if (!tabId) return;

        tabBtns.forEach((b) => {
          b.classList.remove('border-[#54b995]', 'text-white');
          b.classList.add('border-transparent', 'text-[#94a3b8]');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('border-[#54b995]', 'text-white');
        btn.classList.remove('border-transparent', 'text-[#94a3b8]');
        btn.setAttribute('aria-selected', 'true');

        panels.forEach((p) => {
          if (p.id === `kh-panel-${tabId}`) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });

    // Close on backdrop
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Checklist interactive calculator with dynamic color grading
    const checkboxes = document.querySelectorAll<HTMLInputElement>('#kh-checklist-form .kh-check');
    const scoreText = document.getElementById('kh-score-text');
    const levelText = document.getElementById('kh-level-text');
    const resetChecklistBtn = document.getElementById('btn-reset-kh-checklist');

    function updateChecklistScore() {
      let total = 0;
      checkboxes.forEach((cb) => {
        if (cb.checked) {
          total += Number(cb.dataset.weight || 0);
        }
      });

      if (scoreText) {
        scoreText.textContent = `${total}%`;
        if (total >= 85) {
          scoreText.className = 'text-2xl font-black text-[#54b995]';
        } else if (total >= 60) {
          scoreText.className = 'text-2xl font-black text-[#38bdf8]';
        } else if (total >= 30) {
          scoreText.className = 'text-2xl font-black text-[#c5a75a]';
        } else {
          scoreText.className = 'text-2xl font-black text-[#e4b18e]';
        }
      }

      if (levelText) {
        if (total >= 85) {
          levelText.textContent = 'Nivel Óptimo / Conforme Ley 21.719';
          levelText.className = 'text-xs font-bold text-[#54b995]';
        } else if (total >= 60) {
          levelText.textContent = 'Conformidad Media / Acciones Requeridas';
          levelText.className = 'text-xs font-bold text-[#38bdf8]';
        } else if (total >= 30) {
          levelText.textContent = 'Brecha Significativa / En Adecuación';
          levelText.className = 'text-xs font-bold text-[#c5a75a]';
        } else {
          levelText.textContent = 'Riesgo Crítico / No Conforme';
          levelText.className = 'text-xs font-bold text-[#e4b18e]';
        }
      }
    }

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', updateChecklistScore);
    });

    resetChecklistBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      updateChecklistScore();
    });

    // Direct hash or param deep-link trigger (#curaduria or ?curaduria)
    try {
      const params = new URLSearchParams(window.location.search);
      if (params.has('curaduria') || window.location.hash === '#curaduria') {
        openModal();
      }
    } catch {}
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initKnowledgeHub);
    } else {
      initKnowledgeHub();
    }
  }
</script>
