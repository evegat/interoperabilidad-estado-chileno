---
import { TIPOLOGIA_CONFIG, PROTOCOLO_CONFIG } from '../lib/graph-styles.js';
import type { TipoNodo, EstandarProtocolo } from '../types/interoperabilidad.js';

const tipologias = Object.entries(TIPOLOGIA_CONFIG) as [TipoNodo, (typeof TIPOLOGIA_CONFIG)[TipoNodo]][];
const protocolos = Object.entries(PROTOCOLO_CONFIG) as [EstandarProtocolo, (typeof PROTOCOLO_CONFIG)[EstandarProtocolo]][];
---

<div
  id="legend-card"
  class="absolute bottom-4 right-4 z-20 bg-[#0a2320]/95 backdrop-blur-md border border-[#1a433d] rounded-lg shadow-2xl text-xs text-[#8fafaa] max-w-xs transition-all duration-200"
>
  <!-- Legend Header with collapse toggle -->
  <button
    type="button"
    id="legend-toggle"
    class="w-full px-3.5 py-2 flex items-center justify-between font-bold text-[#f7f5ef] hover:text-white border-b border-[#163a34] focus:outline-none"
  >
    <div class="flex items-center space-x-1.5">
      <svg class="w-3.5 h-3.5 text-[#54b995]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
      </svg>
      <span class="text-[11px] uppercase tracking-wider font-extrabold text-[#f7f5ef]">Leyenda Semántica</span>
    </div>
    <svg id="legend-arrow" class="w-4 h-4 text-[#8fafaa] transform transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Legend Content -->
  <div id="legend-body" class="p-3 space-y-3">
    <!-- Nodos -->
    <div>
      <span class="block text-[10px] font-extrabold uppercase tracking-wider text-[#8fafaa] mb-1.5">
        Tipología Institucional (Nodos)
      </span>
      <div class="grid grid-cols-2 gap-1.5">
        {tipologias.map(([_, meta]) => (
          <div class="flex items-center space-x-2">
            <span
              class="w-3 h-3 rounded-sm flex-shrink-0 shadow-sm"
              style={`background-color: ${meta.color};`}
            ></span>
            <span class="text-[11px] text-[#e9efec] truncate font-medium" title={meta.label}>{meta.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Protocolos -->
    <div class="pt-2 border-t border-[#163a34]">
      <span class="block text-[10px] font-extrabold uppercase tracking-wider text-[#8fafaa] mb-1.5">
        Protocolo de Transporte (Aristas)
      </span>
      <div class="space-y-1">
        {protocolos.map(([_, meta]) => (
          <div class="flex items-center justify-between text-[11px]">
            <div class="flex items-center space-x-2">
              <span
                class="w-4 h-0.5 inline-block"
                style={`background-color: ${meta.color}; border-top: 1px ${meta.lineStyle} ${meta.color};`}
              ></span>
              <span class="text-[#e9efec] font-medium">{meta.label}</span>
            </div>
            <span class="text-[10px] font-mono font-bold" style={`color: ${meta.color};`}>
              {meta.short}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function initLegendToggle() {
    const toggle = document.getElementById('legend-toggle');
    const body = document.getElementById('legend-body');
    const arrow = document.getElementById('legend-arrow');

    toggle?.addEventListener('click', () => {
      body?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initLegendToggle);
    } else {
      initLegendToggle();
    }
  }
</script>
