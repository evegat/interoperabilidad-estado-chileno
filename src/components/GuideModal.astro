<script>
  function initGuideModal() {
    const modal = document.getElementById('guide-modal');
    const openBtn = document.getElementById('btn-open-guide');
    const closeBtn = document.getElementById('btn-close-guide');
    const footerCloseBtn = document.getElementById('btn-close-guide-footer');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.guide-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.guide-panel');

    function openModal() {
      const knowledgeHubModal = document.getElementById('knowledge-hub-modal');
      if (knowledgeHubModal && !knowledgeHubModal.classList.contains('hidden')) {
        knowledgeHubModal.classList.add('hidden');
      }
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      try {
        sessionStorage.setItem('observatorio_guide_seen', '1');
      } catch {}
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    footerCloseBtn?.addEventListener('click', closeModal);

    // Auto-open on initial load so visitors immediately understand the map and authorship
    try {
      const params = new URLSearchParams(window.location.search);
      if (!params.has('nomodal')) {
        openModal();
      }
    } catch {
      openModal();
    }

    // Tab switcher logic
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.dataset.guideTab;
        if (!tabId) return;

        // Reset tab button styles
        tabBtns.forEach((b) => {
          b.classList.remove('border-[#d7653b]', 'border-[#54b995]', 'text-white');
          b.classList.add('border-transparent', 'text-[#94a3b8]');
        });

        // Activate clicked tab button
        btn.classList.add('border-[#d7653b]', 'text-white');
        btn.classList.remove('border-transparent', 'text-[#94a3b8]');

        // Show matching panel
        panels.forEach((panel) => {
          if (panel.id === `guide-panel-${tabId}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });

    // Close on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initGuideModal);
    } else {
      initGuideModal();
    }
  }
</script>
