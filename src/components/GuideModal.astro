---
---

<div
  id="guide-modal"
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-3 sm:p-4 hidden transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guide-modal-title"
>
  <div class="bg-[#081d1a] border border-[#163a34] rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden shadow-2xl flex flex-col text-[#8fafaa]">
    
    <!-- Modal Header -->
    <div class="p-5 sm:p-6 border-b border-[#163a34] flex items-start justify-between bg-[#051311]/90">
      <div>
        <div class="flex items-center gap-2 mb-1 flex-wrap">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#54b995] bg-[#12483f] px-2 py-0.5 rounded border border-[#1e5a4f]">
            Guía Operativa & Marco Técnico
          </span>
          <span class="text-[10px] font-mono text-[#e4b18e] bg-[#d7653b]/20 px-2 py-0.5 rounded border border-[#d7653b]/30">
            P029 · Chile en la OCDE 2026
          </span>
        </div>
        <h2 id="guide-modal-title" class="text-xl sm:text-2xl font-black text-white tracking-tight">
          Interoperabilidad del Estado: Qué es, Cómo usar el Mapeo e Hitos Globales
        </h2>
        <p class="text-xs text-[#8fafaa] mt-1 leading-relaxed">
          Comprende el marco legal de la Ley N° 21.180, la evolución técnica de Chile en los rankings de la OCDE y cómo auditar los flujos del Estado.
        </p>
      </div>
      <button
        id="btn-close-guide"
        type="button"
        class="text-[#8fafaa] hover:text-white p-1.5 rounded-lg hover:bg-[#12483f] transition-colors focus:outline-none flex-shrink-0"
        title="Cerrar guía"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Tab Navigation -->
    <div class="flex border-b border-[#163a34] bg-[#061614] px-5 sm:px-6 gap-2 sm:gap-4 overflow-x-auto text-xs font-bold">
      <button
        type="button"
        data-guide-tab="tutorial"
        class="guide-tab-btn py-3 px-2 border-b-2 border-[#54b995] text-white flex items-center gap-1.5 transition-colors whitespace-nowrap"
      >
        <span>🎯 Paso a Paso: Cómo Usar la Plataforma</span>
      </button>
      <button
        type="button"
        data-guide-tab="conceptos"
        class="guide-tab-btn py-3 px-2 border-b-2 border-transparent text-[#8fafaa] hover:text-[#f7f5ef] flex items-center gap-1.5 transition-colors whitespace-nowrap"
      >
        <span>🏛️ Qué es Interoperabilidad e Historia</span>
      </button>
      <button
        type="button"
        data-guide-tab="ocde"
        class="guide-tab-btn py-3 px-2 border-b-2 border-transparent text-[#8fafaa] hover:text-[#f7f5ef] flex items-center gap-1.5 transition-colors whitespace-nowrap"
      >
        <span>📈 Salto Histórico Chile en OCDE (2026)</span>
      </button>
      <button
        type="button"
        data-guide-tab="iniciativas"
        class="guide-tab-btn py-3 px-2 border-b-2 border-transparent text-[#8fafaa] hover:text-[#f7f5ef] flex items-center gap-1.5 transition-colors whitespace-nowrap"
      >
        <span>🌐 Observatorios e Iniciativas Similares</span>
      </button>
    </div>

    <!-- Scrollable Body Content -->
    <div class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-6 text-xs text-[#8fafaa] leading-relaxed">
      
      <!-- TAB 1: TUTORIAL PASO A PASO -->
      <div id="guide-panel-tutorial" class="guide-panel space-y-4">
        <div class="p-4 rounded-xl bg-[#0a2320] border border-[#163a34] text-[#f7f5ef]">
          <h3 class="font-extrabold text-sm text-[#54b995] flex items-center gap-2">
            <span>🚀 4 Pasos para Auditar y Operar el Ecosistema</span>
          </h3>
          <p class="text-xs text-[#8fafaa] mt-1">
            Esta plataforma no es una infografía estática: es un motor topológico interactivo para decisores públicos, auditores, desarrolladores GovTech y periodistas de investigación.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <!-- Paso 1 -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#12483f] text-[#54b995] font-black flex items-center justify-center text-xs">1</span>
              <h4 class="font-bold text-white text-xs">Búsqueda Instantánea con ⌘K o Input</h4>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              Presiona <kbd class="px-1.5 py-0.5 rounded bg-[#12483f] text-white font-mono text-[10px]">⌘K</kbd> o <kbd class="px-1.5 py-0.5 rounded bg-[#12483f] text-white font-mono text-[10px]">Ctrl+K</kbd> desde cualquier lugar. Escribe la sigla (ej. <em>SII, SRCEI, FONASA, ChileCompra</em>) y presiona <kbd class="px-1.5 py-0.5 rounded bg-[#12483f] text-white font-mono text-[10px]">Enter</kbd>: el grafo centrará el nodo de inmediato y abrirá su ficha lateral sin buscarlo manualmente en el canvas.
            </p>
          </div>

          <!-- Paso 2 -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#12483f] text-[#54b995] font-black flex items-center justify-center text-xs">2</span>
              <h4 class="font-bold text-white text-xs">Explorar Nodos y Aristas (Ficha Técnica)</h4>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              Haz click sobre cualquier <strong>círculo (nodo institucional)</strong> o sobre cualquier <strong>flecha (flujo de datos)</strong>. En el panel derecho se desplegará el tipo de dato, protocolo, base legal, expedientes oficiales enlazados y el diagnóstico exacto de la brecha.
            </p>
          </div>

          <!-- Paso 3 -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#12483f] text-[#54b995] font-black flex items-center justify-center text-xs">3</span>
              <h4 class="font-bold text-white text-xs">Alternar a la "Matriz de Brechas"</h4>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              Haz click en el botón naranja <strong>[Matriz de Brechas]</strong> en la barra superior. Cambiarás a una tabla de auditoría donde las 77 instituciones se ordenan de menor a mayor madurez (peor IMI primero), indicando cuántas brechas críticas tienen y qué artículos del DS 12 incumplen.
            </p>
          </div>

          <!-- Paso 4 -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-[#12483f] text-[#54b995] font-black flex items-center justify-center text-xs">4</span>
              <h4 class="font-bold text-white text-xs">Generar Minuta para EvalTI / DIPRES</h4>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              Al seleccionar una institución rezagada, pulsa <strong>"Generar Minuta de Brecha (EvalTI)"</strong>. Obtendrás en 1 clic un informe técnico en Markdown estructurado para postular fondos de inversión TI o responder a observaciones de Contraloría.
            </p>
          </div>
        </div>

        <div class="p-3.5 rounded-lg bg-[#081d1a] border border-[#163a34] flex items-center justify-between text-[11px]">
          <span class="text-[#f7f5ef]">💡 <strong>Consejo de Navegación:</strong> Puedes usar la rueda del ratón para hacer zoom, arrastrar el fondo para moverte o pulsar "Fit" en los controles flotantes de la izquierda para reencuadrar.</span>
        </div>
      </div>

      <!-- TAB 2: QUÉ ES INTEROPERABILIDAD E HISTORIA -->
      <div id="guide-panel-conceptos" class="guide-panel hidden space-y-4">
        <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-2">
          <h3 class="font-extrabold text-sm text-[#54b995]">
            ¿Qué es la Interoperabilidad en el Sector Público?
          </h3>
          <p class="text-[#e9efec]">
            Es la capacidad de las organizaciones públicas diversas de interactuar con vistas a objetivos comunes mutuamente acordados, compartiendo información y conocimientos entre sus respectivos sistemas informáticos de forma segura, estandarizada y continua.
          </p>
          <p class="text-[#8fafaa]">
            Bajo el principio de <em>"Once-Only"</em> (Sólo Una Vez), el Estado **no debe exigirle al ciudadano un documento o certificado que otra repartición pública ya tiene en sus bases de datos**. Si tramitas un subsidio en el Ministerio de Desarrollo Social, el Estado debe consultar automáticamente al Registro Civil y al SII sin obligar a la persona a hacer filas por certificados.
          </p>
        </div>

        <!-- Línea de Tiempo e Historia Documentada -->
        <div class="space-y-3">
          <h4 class="font-extrabold text-white text-xs uppercase tracking-wider flex items-center gap-2">
            <span>📜 Hitos y Marco Jurídico Documentado en Chile</span>
          </h4>

          <div class="space-y-2.5">
            <!-- Hito 1: PISEE inicial -->
            <div class="p-3 rounded-lg bg-[#051311] border-l-4 border-l-[#54b995] border border-[#163a34]">
              <div class="flex items-center justify-between flex-wrap gap-1">
                <strong class="text-white">2005–2010: Nace el bus PISEE y el Oficio Circular N° 15</strong>
                <span class="text-[10px] font-mono text-[#54b995]">Etapa Concentradora</span>
              </div>
              <p class="text-[11px] text-[#8fafaa] mt-1">
                Se crea la Plataforma Integrada de Servicios Electrónicos del Estado (PISEE) como un bus único centralizado de integración para conectar ministerios, operado por Segpres. Las instituciones debían desarrollar conectores SOAP/XML pesados.
              </p>
            </div>

            <!-- Hito 2: Ley 21.180 -->
            <div class="p-3 rounded-lg bg-[#051311] border-l-4 border-l-[#38bdf8] border border-[#163a34]">
              <div class="flex items-center justify-between flex-wrap gap-1">
                <strong class="text-white">2019: Promulgación de la Ley N° 21.180</strong>
                <a href="https://www.bcn.cl/leychile/navegar?idNorma=1138547" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#38bdf8] underline hover:text-white">
                  Ley N° 21.180 (BCN) ↗
                </a>
              </div>
              <p class="text-[11px] text-[#8fafaa] mt-1">
                Establece la <strong>Transformación Digital del Estado</strong> como un mandato legal imperativo: todos los procedimientos administrativos deben realizarse en soporte electrónico y comunicarse mediante interoperabilidad obligatoria.
              </p>
            </div>

            <!-- Hito 3: DS 4/2020 -->
            <div class="p-3 rounded-lg bg-[#051311] border-l-4 border-l-[#c5a75a] border border-[#163a34]">
              <div class="flex items-center justify-between flex-wrap gap-1">
                <strong class="text-white">2020: DS N° 4/2020 MinSegpres (Reglamento Ley 21.180)</strong>
                <a href="https://www.bcn.cl/leychile/navegar?idNorma=1169116" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#c5a75a] underline hover:text-white">
                  DS N° 4/2020 (BCN) ↗
                </a>
              </div>
              <p class="text-[11px] text-[#8fafaa] mt-1">
                Reglamento que formaliza las fases de implementación (Comunicaciones, Notificaciones, Procedimientos e Interoperabilidad) y fija los deberes generales de gobernanza digital.
              </p>
            </div>

            <!-- Hito 4: DS 12/2023 -->
            <div class="p-3 rounded-lg bg-[#051311] border-l-4 border-l-[#d7653b] border border-[#163a34]">
              <div class="flex items-center justify-between flex-wrap gap-1">
                <strong class="text-white">2023: DS N° 12/2023 MinSegpres (Norma Técnica de Interoperabilidad)</strong>
                <a href="https://www.bcn.cl/leychile/navegar?idNorma=1198539" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#e4b18e] underline hover:text-white">
                  DS N° 12/2023 (BCN) ↗
                </a>
              </div>
              <p class="text-[11px] text-[#8fafaa] mt-1">
                Jubila el paradigma del bus concentrador y crea la <strong>Red de Interoperabilidad basada en Nodos distribuidos</strong> y servicios comunes de la SGD: Catálogo, Gestor de Acuerdos, Gestor de Códigos y Gestor de Autorizaciones/Consentimiento.
              </p>
            </div>

            <!-- Hito 5: Ley 21.658 y 21.719 -->
            <div class="p-3 rounded-lg bg-[#051311] border-l-4 border-l-[#a78bfa] border border-[#163a34]">
              <div class="flex items-center justify-between flex-wrap gap-1">
                <strong class="text-white">2024–2026: SGD en Hacienda y Ley N° 21.719 de Datos Personales</strong>
                <span class="text-[10px] font-mono text-[#a78bfa]">Vigencia Plena</span>
              </div>
              <p class="text-[11px] text-[#8fafaa] mt-1">
                La Secretaría de Gobierno Digital se traslada al Ministerio de Hacienda (Ley 21.658) y la aprobación de la nueva Ley de Datos Personales (Ley 21.719) exige consentimiento estricto trazable en cada consulta interinstitucional.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: SALTO HISTÓRICO CHILE EN LA OCDE (2026) -->
      <div id="guide-panel-ocde" class="guide-panel hidden space-y-4">
        <!-- Noticia Destacada -->
        <div class="p-5 rounded-xl bg-gradient-to-r from-[#0c2420] via-[#0e332c] to-[#12483f] border border-[#54b995]/50 shadow-xl space-y-3">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#54b995] text-[#061614] font-black text-[10px] uppercase tracking-wider">
              Hito Histórico Internacional · Febrero 2026
            </span>
            <span class="text-[11px] font-mono text-[#54b995]">OECD Digital Government Index (DGI)</span>
          </div>
          
          <h3 class="text-base sm:text-lg font-black text-white leading-snug">
            Chile salta 22 puestos en el ranking de Gobierno Digital de la OCDE: del lugar 32 al Top 10 global (N° 1 en América Latina)
          </h3>

          <p class="text-[#e9efec] text-xs leading-relaxed">
            En la última medición del <strong>Digital Government Index (DGI)</strong> publicada por la Organización para la Cooperación y el Desarrollo Económicos (OCDE), Chile protagonizó el mayor ascenso de su historia: escaló del puesto 32 al <strong>10° lugar a nivel mundial</strong>, obteniendo una puntuación de <strong>0,79</strong> (por sobre el promedio OCDE de 0,605) y consolidándose como el <strong>líder absoluto en América Latina</strong>.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 border-t border-[#1e5a4f]/60 text-center">
            <div class="bg-[#051311]/60 p-2 rounded-lg">
              <span class="block text-[10px] text-[#8fafaa] uppercase font-bold">Posición Global</span>
              <span class="text-base font-black text-[#54b995]">Puesto 10</span>
            </div>
            <div class="bg-[#051311]/60 p-2 rounded-lg">
              <span class="block text-[10px] text-[#8fafaa] uppercase font-bold">América Latina</span>
              <span class="text-base font-black text-[#38bdf8]">N° 1</span>
            </div>
            <div class="bg-[#051311]/60 p-2 rounded-lg">
              <span class="block text-[10px] text-[#8fafaa] uppercase font-bold">Ascenso</span>
              <span class="text-base font-black text-[#e4b18e]">+22 Lugares</span>
            </div>
            <div class="bg-[#051311]/60 p-2 rounded-lg">
              <span class="block text-[10px] text-[#8fafaa] uppercase font-bold">Puntaje DGI</span>
              <span class="text-base font-black text-white">0,79 / 1.0</span>
            </div>
          </div>
        </div>

        <!-- Análisis Crítico y Qué Significa para Este Mapeo -->
        <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-2">
          <h4 class="font-bold text-white text-xs flex items-center gap-2">
            <span>🔍 ¿Por qué subió Chile y cuál es la brecha pendiente?</span>
          </h4>
          <p class="text-[#8fafaa] text-[11px] leading-relaxed">
            La OCDE reconoció los avances estructurales de Chile en <strong>gobernanza centralizada</strong> (creación de la SGD con rango ministerial en Hacienda), la adopción masiva de <strong>ClaveÚnica</strong> (más de 15 millones de usuarios) y el marco formal de la <strong>Ley 21.180</strong>.
          </p>
          <p class="text-[#f7f5ef] text-[11px] leading-relaxed">
            <strong>Sin embargo, el ranking mide diseño de políticas e instrumentos normativos; este visualizador audita la realidad técnica en terreno.</strong> Mientras en el papel Chile figura en el Top 10, la auditoría muestra que el <strong>72% de las interacciones aún operan por convenios bilaterales directos o intercambios de archivos planos SFTP</strong>, y persisten 19 brechas críticas por falta de Nodos de Interoperabilidad distribuidos (Art. 4 DS 12/2023).
          </p>
          <div class="pt-2 flex items-center gap-2">
            <a href="https://digital.gob.cl" target="_blank" rel="noopener noreferrer" class="text-[11px] text-[#54b995] font-bold underline hover:text-white">
              Comunicado Oficial de Gobierno Digital ↗
            </a>
            <span class="text-[#8fafaa]">·</span>
            <a href="https://www.oecd.org/digital/digital-government/" target="_blank" rel="noopener noreferrer" class="text-[11px] text-[#38bdf8] font-bold underline hover:text-white">
              OECD Digital Government Index Portal ↗
            </a>
          </div>
        </div>
      </div>

      <!-- TAB 4: OBSERVATORIOS E INICIATIVAS SIMILARES -->
      <div id="guide-panel-iniciativas" class="guide-panel hidden space-y-4">
        <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-2">
          <h3 class="font-extrabold text-sm text-[#54b995]">
            Iniciativas Similares y Observatorios de Referencia
          </h3>
          <p class="text-[#e9efec]">
            El mapeo de grafos de interoperabilidad de P029 se inspira y dialoga con los principales observatorios e iniciativas de administración electrónica a nivel global e iberoamericano:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <!-- Referente 1: España CTT y PAe -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-white text-xs">🇪🇸 Esquema Nacional de Interoperabilidad (ENI)</h4>
              <span class="text-[10px] font-mono text-[#54b995]">España</span>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              Operado a través del <strong>PAe (Portal de Administración Electrónica)</strong> y el <strong>Centro de Transferencia de Tecnología (CTT)</strong>. Mantiene un directorio público de servicios comunes interoperables y soluciones tecnológicas reutilizables entre comunidades autónomas y ministerios.
            </p>
            <a href="https://administracionelectronica.gob.es" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#54b995] font-bold underline block pt-1">
              Portal PAe / CTT España ↗
            </a>
          </div>

          <!-- Referente 2: X-Road Visualizer Estonia -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-white text-xs">🇪🇪 X-Road Visualizer & Metrics</h4>
              <span class="text-[10px] font-mono text-[#38bdf8]">Estonia / NIIS</span>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              El Instituto Nórdico para Soluciones de Interoperabilidad (NIIS) publica un tablero interactivo con el flujo de transacciones de X-Road en vivo, visualizando las conexiones entre subsistemas del Estado estonio y finlandés en tiempo real.
            </p>
            <a href="https://x-road.global" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#38bdf8] font-bold underline block pt-1">
              X-Road Global Metrics ↗
            </a>
          </div>

          <!-- Referente 3: Red Gealc & OEA/BID -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-white text-xs">🌎 Red GEALC (OEA / BID)</h4>
              <span class="text-[10px] font-mono text-[#c5a75a]">Latinoamérica</span>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              Red de Gobierno Electrónico de América Latina y el Caribe. Reúne a los directores de gobierno digital de la región para estandarizar marcos de interoperabilidad transfronteriza y firma digital intergubernamental.
            </p>
            <a href="https://redgealc.org" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#c5a75a] font-bold underline block pt-1">
              Red Gealc Oficial ↗
            </a>
          </div>

          <!-- Referente 4: OPSI OCDE -->
          <div class="p-4 rounded-xl bg-[#051311] border border-[#163a34] space-y-1.5 hover:border-[#1e5a4f] transition-all">
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-white text-xs">🏛️ OPSI — Observatory of Public Sector Innovation</h4>
              <span class="text-[10px] font-mono text-[#a78bfa]">OCDE Global</span>
            </div>
            <p class="text-[11px] text-[#8fafaa]">
              El observatorio de innovación pública de la OCDE recopila casos de estudio globales sobre rediseño de arquitecturas de datos, interoperabilidad semántica y transformación de servicios hacia modelos proactivos.
            </p>
            <a href="https://oecd-opsi.org" target="_blank" rel="noopener noreferrer" class="text-[10px] text-[#a78bfa] font-bold underline block pt-1">
              Observatory OECD-OPSI ↗
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="p-4 border-t border-[#163a34] bg-[#051311]/90 flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="text-[11px] text-[#8fafaa]">
        Desarrollado como iniciativa de investigación GovTech independiente · <a href="https://evegat.cl" target="_blank" rel="noopener noreferrer" class="text-[#54b995] font-bold hover:underline">evegat.cl</a>
      </span>
      <button
        id="btn-close-guide-footer"
        type="button"
        class="px-4 py-2 bg-[#12483f] hover:bg-[#1a5e52] text-white rounded-lg font-bold text-xs border border-[#235d52] hover:border-[#54b995] transition-colors focus:outline-none"
      >
        Entendido, Ir al Mapeo
      </button>
    </div>

  </div>
</div>

<script>
  function initGuideModal() {
    const modal = document.getElementById('guide-modal');
    const openBtn = document.getElementById('btn-open-guide');
    const closeBtn = document.getElementById('btn-close-guide');
    const footerCloseBtn = document.getElementById('btn-close-guide-footer');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.guide-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.guide-panel');

    function openModal() {
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    footerCloseBtn?.addEventListener('click', closeModal);

    // Tab switcher logic
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.dataset.guideTab;
        if (!tabId) return;

        // Reset tab button styles
        tabBtns.forEach((b) => {
          b.classList.remove('border-[#54b995]', 'text-white');
          b.classList.add('border-transparent', 'text-[#8fafaa]');
        });

        // Activate clicked tab button
        btn.classList.add('border-[#54b995]', 'text-white');
        btn.classList.remove('border-transparent', 'text-[#8fafaa]');

        // Show matching panel
        panels.forEach((panel) => {
          if (panel.id === `guide-panel-${tabId}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });

    // Close on background click
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initGuideModal);
    } else {
      initGuideModal();
    }
  }
</script>
