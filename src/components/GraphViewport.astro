---
---

<div id="graph-container" class="relative w-full h-[calc(100vh-170px)] min-h-[550px] bg-[#090d16] overflow-hidden select-none">
  <!-- Cytoscape Canvas Mount Target -->
  <div id="cy" class="w-full h-full cursor-grab active:cursor-grabbing"></div>

  <!-- Loading Skeleton Overlay -->
  <div
    id="graph-loader"
    class="absolute inset-0 flex flex-col items-center justify-center bg-[#090d16]/90 z-20 transition-opacity duration-300 pointer-events-none"
  >
    <div class="relative w-16 h-16 mb-4">
      <div class="absolute inset-0 rounded-full border-4 border-[#1e3a5f]"></div>
      <div class="absolute inset-0 rounded-full border-4 border-[#c2542d] border-t-transparent animate-spin"></div>
    </div>
    <span class="text-sm font-bold text-[#f1f5f9] animate-pulse">
      Cargando ecosistema de interoperabilidad...
    </span>
    <span class="text-xs text-[#94a3b8] mt-1">
      Resolviendo topología de flujos del Estado chileno
    </span>
  </div>

  <!-- Floating Navigation HUD Controls -->
  <div class="absolute top-4 left-4 z-10 flex flex-col space-y-1.5 bg-[#0e1626]/95 backdrop-blur-md p-1.5 rounded-lg border border-[#1e293b] shadow-2xl">
    <button
      type="button"
      id="hud-zoom-in"
      data-action="zoom-in"
      class="w-8 h-8 flex items-center justify-center text-[#f1f5f9] hover:text-[#54b995] bg-[#1e293b] hover:bg-[#334155] rounded transition-colors focus:outline-none focus:ring-1 focus:ring-[#c2542d]"
      title="Acercar (Zoom In)"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
    </button>
    <button
      type="button"
      id="hud-zoom-out"
      data-action="zoom-out"
      class="w-8 h-8 flex items-center justify-center text-[#f1f5f9] hover:text-[#54b995] bg-[#1e293b] hover:bg-[#334155] rounded transition-colors focus:outline-none focus:ring-1 focus:ring-[#c2542d]"
      title="Alejar (Zoom Out)"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4" />
      </svg>
    </button>
    <div class="h-px bg-[#1e293b] my-0.5"></div>
    <button
      type="button"
      id="hud-fit"
      data-action="fit"
      class="w-8 h-8 flex items-center justify-center text-[#f1f5f9] hover:text-[#54b995] bg-[#1e293b] hover:bg-[#334155] rounded transition-colors focus:outline-none focus:ring-1 focus:ring-[#c2542d]"
      title="Ajustar al encuadre (Fit Viewport)"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
      </svg>
    </button>
    <button
      type="button"
      id="hud-reset"
      data-action="reset"
      class="w-8 h-8 flex items-center justify-center text-[#f1f5f9] hover:text-[#54b995] bg-[#1e293b] hover:bg-[#334155] rounded transition-colors focus:outline-none focus:ring-1 focus:ring-[#c2542d]"
      title="Recalcular Layout (Reset)"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
    </button>
  </div>

  <!-- Operational Interaction Hint -->
  <div class="absolute bottom-3 left-4 z-10 hidden sm:flex items-center space-x-3 text-[11px] text-[#94a3b8] bg-[#0e1626]/90 backdrop-blur px-3 py-1.5 rounded-md border border-[#1e293b] shadow">
    <span class="inline-flex items-center gap-1">
      <kbd class="px-1.5 py-0.5 bg-[#1e293b] border border-[#334155] rounded text-[10px] text-[#f1f5f9] font-bold">Click</kbd> Ficha
    </span>
    <span class="inline-flex items-center gap-1">
      <kbd class="px-1.5 py-0.5 bg-[#1e293b] border border-[#334155] rounded text-[10px] text-[#f1f5f9] font-bold">Arrastrar</kbd> Paneo
    </span>
    <span class="inline-flex items-center gap-1">
      <kbd class="px-1.5 py-0.5 bg-[#1e293b] border border-[#334155] rounded text-[10px] text-[#f1f5f9] font-bold">Rueda</kbd> Zoom
    </span>
  </div>

  <!-- Author Signature Watermark (Discreet) -->
  <div class="absolute bottom-3 left-1/2 transform -translate-x-1/2 z-10 hidden md:flex items-center space-x-2 text-[11px] text-[#94a3b8] bg-[#0e1626]/80 backdrop-blur-md px-3.5 py-1 rounded-full border border-[#1e293b]">
    <span>Investigación y Desarrollo:</span>
    <a href="https://evegat.cl" target="_blank" rel="noopener noreferrer" class="text-[#f1f5f9] hover:text-[#c2542d] font-bold underline decoration-[#c2542d] transition-colors">
      Eduardo Vega Toledo (evegat.cl)
    </a>
  </div>
</div>
