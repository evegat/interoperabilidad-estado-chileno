---
import type { DatasetInteroperabilidad } from '../types/interoperabilidad.js';

interface Props {
  dataset: DatasetInteroperabilidad;
}

const { dataset } = Astro.props;

const totalNodos = dataset.nodos.length;
const totalAristas = dataset.aristas.length;
const busesCentrales = dataset.nodos.filter((n) => n.tipo === 'bus_transversal').length;
const restEdges = dataset.aristas.filter((e) => e.estandar_o_protocolo.includes('REST')).length;
const percentRest = Math.round((restEdges / totalAristas) * 100);
const brechasCriticas = dataset.aristas.filter(
  (e) => e.brecha_observada && e.brecha_observada.trim().length > 5
).length;
---

<header class="bg-slate-900 border-b border-slate-800 text-white shadow-lg sticky top-0 z-30">
  <!-- Top brand bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <!-- Title & Branding -->
      <div class="flex items-center space-x-3">
        <div class="w-2.5 h-10 bg-gradient-to-b from-blue-600 via-white to-red-600 rounded-sm shadow-sm"></div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-lg md:text-xl font-bold tracking-tight text-slate-100">
              Mapeo de Interoperabilidad del Estado Chileno
            </h1>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-900/60 text-blue-300 border border-blue-700/50">
              P029 · MVP
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Ley N° 21.180 sobre Transformación Digital · PISEE 2.0 · Flujos Interinstitucionales Verificados
          </p>
        </div>
      </div>

      <!-- Instant Search Input -->
      <div class="relative w-full md:w-80">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          id="search-input"
          name="search"
          type="text"
          placeholder="Buscar institución (ej. Registro Civil, SII, TGR)..."
          class="block w-full pl-9 pr-3 py-1.5 bg-slate-950/80 border border-slate-700 rounded-lg text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          autocomplete="off"
        />
      </div>
    </div>

    <!-- Summary KPI Indicators -->
    <div class="mt-3 pt-2.5 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-4 text-center">
      <div class="bg-slate-950/40 rounded px-2.5 py-1.5 border border-slate-800/60">
        <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold">Instituciones</span>
        <span id="kpi-nodos" class="text-base font-bold text-slate-100">{totalNodos}</span>
      </div>
      <div class="bg-slate-950/40 rounded px-2.5 py-1.5 border border-slate-800/60">
        <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold">Flujos Totales</span>
        <span id="kpi-aristas" class="text-base font-bold text-slate-100">{totalAristas}</span>
      </div>
      <div class="bg-slate-950/40 rounded px-2.5 py-1.5 border border-slate-800/60">
        <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold">Buses Centrales</span>
        <span class="text-base font-bold text-emerald-400">{busesCentrales}</span>
      </div>
      <div class="bg-slate-950/40 rounded px-2.5 py-1.5 border border-slate-800/60">
        <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold">Adopción REST</span>
        <span class="text-base font-bold text-cyan-400">{percentRest}%</span>
      </div>
      <div class="bg-slate-950/40 rounded px-2.5 py-1.5 border border-slate-800/60 col-span-2 sm:col-span-1">
        <span class="block text-xs text-slate-400 uppercase tracking-wider font-semibold">Brechas Críticas</span>
        <span class="text-base font-bold text-amber-400">{brechasCriticas}</span>
      </div>
    </div>
  </div>
</header>
