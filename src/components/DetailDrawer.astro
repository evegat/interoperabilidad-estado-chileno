<script>
  import type { SelectionEventDetail, NodeDrawerPayload, EdgeDrawerPayload } from '../lib/graph-controller.js';

  function initDetailDrawer() {
    const drawer = document.getElementById('detail-drawer');
    const closeBtn = document.getElementById('drawer-close');
    const emptyState = document.getElementById('drawer-empty-state');
    const nodeView = document.getElementById('drawer-node-view');
    const edgeView = document.getElementById('drawer-edge-view');
    const typeBadge = document.getElementById('drawer-type-badge');
    const statusBadge = document.getElementById('drawer-status-badge');

    // Close Button Click
    closeBtn?.addEventListener('click', () => {
      drawer?.classList.add('translate-x-full');
    });

    // Close drawer on ESC key (only if benchmark/guide/knowledge-hub modals are not open — BUG-08 fix)
    window.addEventListener('keydown', (e) => {
      const benchmarkModal = document.getElementById('benchmark-modal');
      const guideModal = document.getElementById('guide-modal');
      const knowledgeHubModal = document.getElementById('knowledge-hub-modal');
      const isBenchmarkOpen = benchmarkModal && !benchmarkModal.classList.contains('hidden');
      const isGuideOpen = guideModal && !guideModal.classList.contains('hidden');
      const isKnowledgeHubOpen = knowledgeHubModal && !knowledgeHubModal.classList.contains('hidden');
      if (e.key === 'Escape' && !isBenchmarkOpen && !isGuideOpen && !isKnowledgeHubOpen && drawer && !drawer.classList.contains('translate-x-full')) {
        drawer.classList.add('translate-x-full');
      }
    });

    // Listen for custom graph selection events
    const handleSelection = (event: CustomEvent<SelectionEventDetail>) => {
      const detail = event.detail;
      if (!drawer) return;

      if (!detail || detail.type === 'none') {
        drawer.classList.add('translate-x-full');
        return;
      }

      // Open drawer
      drawer.classList.remove('translate-x-full');

      if (detail.type === 'node' && detail.payload) {
        renderNodeSheet(detail.payload);
      } else if (detail.type === 'edge' && detail.payload) {
        renderEdgeSheet(detail.payload);
      }
    };

    window.addEventListener('selection-changed', handleSelection as EventListener);
    window.addEventListener('graph-selection', handleSelection as EventListener);

    function renderNodeSheet(node: NodeDrawerPayload) {
      if (!emptyState || !nodeView || !edgeView || !typeBadge || !statusBadge) return;

      emptyState.classList.add('hidden');
      edgeView.classList.add('hidden');
      nodeView.classList.remove('hidden');

      typeBadge.textContent = 'Institución';
      statusBadge.classList.add('hidden');

      // Populate Fields
      const elSigla = document.getElementById('node-sigla');
      const elId = document.getElementById('node-id');
      const elNombre = document.getElementById('node-nombre');
      const elTipo = document.getElementById('node-tipo');
      const elDependencia = document.getElementById('node-dependencia');
      const elMadurez = document.getElementById('node-madurez');
      const elLey = document.getElementById('node-ley');
      const elRol = document.getElementById('node-rol');
      const elTotal = document.getElementById('node-total-conexiones');
      const elIn = document.getElementById('node-in-degree');
      const elOut = document.getElementById('node-out-degree');
      const elFlowsList = document.getElementById('node-flows-list');
      const elLink = document.getElementById('node-website-link') as HTMLAnchorElement | null;

      if (elSigla) elSigla.textContent = node.sigla;
      if (elId) elId.textContent = node.id;
      if (elNombre) elNombre.textContent = node.nombre;
      if (elTipo) elTipo.textContent = node.tipo.replace('_', ' ');
      if (elDependencia) elDependencia.textContent = node.dependencia;
      if (elMadurez) elMadurez.textContent = node.nivel_madurez_digital;
      if (elLey) elLey.textContent = node.estado_adopcion_ley21180;
      if (elRol) elRol.textContent = node.rol_ecosistema;
      if (elTotal) elTotal.textContent = `${node.total_conexiones} flujos`;
      if (elIn) elIn.textContent = String(node.in_degree);
      if (elOut) elOut.textContent = String(node.out_degree);

      if (elLink) {
        if (node.sitio_web && node.sitio_web !== '#') {
          elLink.href = node.sitio_web;
          elLink.title = `Abrir ${node.sitio_web}`;
          elLink.classList.remove('hidden');
        } else {
          elLink.removeAttribute('href');
          elLink.classList.add('hidden');
        }
      }

      const elNodeReportLink = document.getElementById('node-report-update-link') as HTMLAnchorElement | null;
      if (elNodeReportLink) {
        const issueTitle = encodeURIComponent(`[Actualización Institucional] ${node.sigla} - ${node.nombre}`);
        const issueBody = encodeURIComponent(
          `## Solicitud de Actualización / Derecho a Réplica Institucional\n\n` +
          `- **Organismo:** ${node.nombre} (${node.sigla})\n` +
          `- **ID Nodo:** \`${node.id}\`\n` +
          `- **Nivel de Conexión Digital Actual:** Nivel ${node.nivel_madurez_interoperabilidad || 3} (${node.indice_madurez_interoperabilidad || 50}%)\n\n` +
          `### 1. Cambio o Migración Técnica Reportada\n` +
          `(Describa si se habilitó un Nodo de Interoperabilidad DS N° 12/2023, migración a REST/JSON o incorporación al Catálogo SGD)\n\n` +
          `### 2. Evidencia Oficial Verificable (Obligatorio)\n` +
          `- **URL Resolución Exenta / Convenio / Ficha Catálogo SGD:** \n` +
          `- **URL Especificación OpenAPI / Swagger (si aplica):** \n`
        );
        elNodeReportLink.href = `https://github.com/evegat/interoperabilidad-estado-chileno/issues/new?title=${issueTitle}&body=${issueBody}`;
      }

      // Populate Nivel de Conexión Digital
      const imiScore = typeof node.indice_madurez_interoperabilidad === 'number' ? node.indice_madurez_interoperabilidad : 50;
      const imiLevel = node.nivel_madurez_interoperabilidad || (imiScore >= 81 ? 5 : imiScore >= 61 ? 4 : imiScore >= 41 ? 3 : imiScore >= 21 ? 2 : 1);
      
      const imiDescriptions: Record<number, { title: string; badge: string; colorClass: string }> = {
        1: { title: 'Silo / Papel (Trámites manuales u oficios)', badge: 'Nivel 1: Silo / Papel (0–20%)', colorClass: 'bg-[#9f1239] text-white border-[#be123c]' },
        2: { title: 'Trámite Manual / SFTP (Lotes planos o planillas)', badge: 'Nivel 2: Trámite Manual / SFTP (21–40%)', colorClass: 'bg-[#c5a75a]/20 text-[#c5a75a] border-[#c5a75a]/40' },
        3: { title: 'Conexión Básica (PISEE legacy o consumo parcial)', badge: 'Nivel 3: Conexión Básica (41–60%)', colorClass: 'bg-[#1b4965]/40 text-[#38bdf8] border-[#38bdf8]/40' },
        4: { title: 'Conectado por API (Interfaces REST mTLS operativas)', badge: 'Nivel 4: Conectado por API (61–80%)', colorClass: 'bg-[#0b4aa2] text-[#54b995] border-[#1d4d91]' },
        5: { title: '100% Digital / Cero Papel (Once-Only y catálogo pleno)', badge: 'Nivel 5: 100% Digital / Cero Papel (81–100%)', colorClass: 'bg-[#54b995]/20 text-[#54b995] border-[#54b995]/50' },
      };

      const elImiBadge = document.getElementById('node-imi-badge');
      const elImiDesc = document.getElementById('node-imi-level-desc');
      const elImiScore = document.getElementById('node-imi-score');
      const elImiBar = document.getElementById('node-imi-bar');

      const imiMeta = imiDescriptions[imiLevel] || imiDescriptions[3];
      if (elImiBadge) {
        elImiBadge.textContent = imiMeta.badge;
        elImiBadge.className = `px-2 py-0.5 rounded text-[10px] font-bold border ${imiMeta.colorClass}`;
      }
      if (elImiDesc) elImiDesc.textContent = imiMeta.title;
      if (elImiScore) elImiScore.textContent = `${imiScore}% (${imiScore} / 100 pts)`;
      if (elImiBar) elImiBar.style.width = `${Math.max(5, Math.min(100, imiScore))}%`;

      // Update immediate summary header badges & silo banner
      const elSummaryDocsText = document.getElementById('node-summary-docs-text');
      const elSummaryImiBadge = document.getElementById('node-summary-imi-badge');
      const elThemeBadge = document.getElementById('node-theme-badge');
      const elSiloBanner = document.getElementById('node-silo-banner');

      if (elSummaryImiBadge) {
        elSummaryImiBadge.textContent = `Digital: ${imiScore}% (N${imiLevel})`;
        elSummaryImiBadge.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-[#031329] text-[#e4b18e] border border-[#1e3a5f]';
      }

      const themeLabels: Record<string, string> = {
        identidad_ciudadana: '🆔 Identidad y ClaveÚnica',
        educacion_becas: '🎓 Educación y Becas',
        salud_seguridad_social: '🏥 Salud y Licencias',
        vivienda_urbanismo: '🏠 Vivienda y Bienes Raíces',
        trabajo_pensiones: '💼 Trabajo y Pensiones',
        proteccion_social: '👥 Protección Social (RSH)',
        finanzas_tributario: '💰 Impuestos y Pymes',
        justicia_seguridad: '⚖️ Justicia y Seguridad',
        transporte_movilidad: '🚗 Transporte y Circulación',
      };
      if (elThemeBadge) {
        const themeKey = node.eje_tematico || 'identidad_ciudadana';
        elThemeBadge.textContent = themeLabels[themeKey] || 'Sector Público';
      }

      if (elSiloBanner) {
        if (node.es_silo) {
          elSiloBanner.classList.remove('hidden');
        } else {
          elSiloBanner.classList.add('hidden');
        }
      }

      // Compute 5-factor auditable breakdown totaling exactly imiScore
      // Factor 1: Canal Oficial (DS 12 Art. 4)
      let w1 = 5;
      let d1 = 'Sin nodo formal / convenios ad-hoc';
      if (node.tipo_despliegue_nodo === 'nodo_propio') {
        w1 = 20;
        d1 = 'Nodo propio federado con mTLS (PISEE 2.0)';
      } else if (node.tipo_despliegue_nodo === 'nodo_delegado') {
        w1 = 16;
        d1 = 'Nodo delegado sectorial u operado por SGD';
      } else if (node.estado_adopcion_ley21180 === 'fase_3_interoperabilidad') {
        w1 = 14;
        d1 = 'Fase 3: Red de interoperabilidad activa';
      } else if (node.estado_adopcion_ley21180 === 'fase_2_procedimientos') {
        w1 = 10;
        d1 = 'Fase 2: Procedimientos electrónicos';
      }

      // Factor 2: Protocolo REST (DS 12 Art. 8)
      let w2 = 4;
      let d2 = 'Intercambio manual o batch plano';
      if (node.agent_ready) {
        w2 = 20;
        d2 = 'APIs REST sincrónicas con OpenAPI 3.1';
      } else if (node.nivel_madurez_digital === 'alto') {
        w2 = 18;
        d2 = 'Servicios web sincrónicos modernos REST / JSON';
      } else if (node.nivel_madurez_digital === 'medio') {
        w2 = 12;
        d2 = 'Protocolos mixtos (SOAP / XML o SFTP)';
      }

      // Factor 3: Gobernanza SGD (DS 12 Art. 13)
      const docsCount = node.documentacion_oficial?.length || 0;
      let w3 = 6;
      let d3 = 'Convenios bilaterales ad-hoc en proceso';
      if (docsCount >= 3) {
        w3 = 20;
        d3 = `${docsCount} convenios y marcos jurídicos en catálogo SGD`;
      } else if (docsCount >= 1) {
        w3 = 14;
        d3 = `${docsCount} convenio(s) vigente(s) formalizado(s)`;
      } else if (node.tipo === 'bus_transversal' || node.tipo === 'ministerio') {
        w3 = 14;
        d3 = 'Marco normativo habilitante sectorial';
      }

      // Factor 4: Once-Only (Ley 21.180 Art. 1°)
      let w4 = 4;
      let d4 = 'Dependencia de certificados o ventanilla física';
      if (node.tipo === 'bus_transversal' || (node.out_degree || 0) >= 4) {
        w4 = 20;
        d4 = 'Emisor clave Once-Only (cero certificados al ciudadano)';
      } else if (node.nivel_madurez_digital === 'alto') {
        w4 = 17;
        d4 = 'Consumo e intercambio directo entre organismos';
      } else if (node.nivel_madurez_digital === 'medio') {
        w4 = 11;
        d4 = 'Trámites mixtos (avanzando en erradicación de papel)';
      }

      // Factor 5: Seguridad y Privacidad (Ley 21.719 / 21.663)
      let w5 = 6;
      const secChecks: string[] = [];
      if (node.compliance_ley21719?.oficial_proteccion_datos) { w5 += 5; secChecks.push('DPO'); }
      if (node.compliance_ley21719?.registro_actividades_tratamiento) { w5 += 5; secChecks.push('RAT'); }
      if (node.compliance_ley21719?.politica_privacidad_actualizada) { w5 += 4; secChecks.push('Política APDP'); }
      if (node.calificacion_ciberseguridad) { w5 = Math.min(20, w5 + 2); secChecks.push('ANCI'); }
      const d5 = secChecks.length > 0 ? secChecks.join(' + ') + ' acreditados' : 'Adecuación en curso';

      // Distribute imiScore deterministically across the 5 factors so sum === imiScore exactly
      const weights = [w1, w2, w3, w4, w5];
      const sumW = weights.reduce((a, b) => a + b, 0);
      let scores = weights.map((w) => Math.min(20, Math.max(0, Math.round((w / (sumW || 1)) * imiScore))));
      let currentSum = scores.reduce((a, b) => a + b, 0);
      let diff = imiScore - currentSum;

      let attempts = 0;
      while (diff !== 0 && attempts < 100) {
        attempts++;
        if (diff > 0) {
          let bestIdx = -1;
          let bestW = -1;
          for (let i = 0; i < 5; i++) {
            if (scores[i] < 20 && weights[i] > bestW) {
              bestW = weights[i];
              bestIdx = i;
            }
          }
          if (bestIdx !== -1) {
            scores[bestIdx]++;
            diff--;
          } else {
            break;
          }
        } else {
          let bestIdx = -1;
          let minW = 999;
          for (let i = 0; i < 5; i++) {
            if (scores[i] > 0 && weights[i] < minW) {
              minW = weights[i];
              bestIdx = i;
            }
          }
          if (bestIdx !== -1) {
            scores[bestIdx]--;
            diff++;
          } else {
            break;
          }
        }
      }

      // Populate DOM elements for the 5 factors
      const factorConfigs = [
        { id: 'canal', score: scores[0], desc: d1 },
        { id: 'proto', score: scores[1], desc: d2 },
        { id: 'gob', score: scores[2], desc: d3 },
        { id: 'once', score: scores[3], desc: d4 },
        { id: 'sec', score: scores[4], desc: d5 },
      ];

      factorConfigs.forEach(({ id, score, desc }) => {
        const elScore = document.getElementById(`factor-${id}-score`);
        const elBar = document.getElementById(`factor-${id}-bar`);
        const elDesc = document.getElementById(`factor-${id}-desc`);
        if (elScore) elScore.textContent = `${score} / 20 pts`;
        if (elBar) elBar.style.width = `${Math.min(100, Math.round((score / 20) * 100))}%`;
        if (elDesc) elDesc.textContent = desc;
      });

      // Populate / Toggle Agent-Ready Capabilities Card (desacoplada de IMI)
      const elAgentReadyCard = document.getElementById('node-agent-ready-card');
      if (elAgentReadyCard) {
        if (node.agent_ready) {
          elAgentReadyCard.classList.remove('hidden');
          const cap = node.capacidades_agente;
          const elCapMcp = document.getElementById('cap-mcp');
          const elCapOpenapi = document.getElementById('cap-openapi');
          const elCapEvents = document.getElementById('cap-events');
          const elCapIdempotencia = document.getElementById('cap-idempotencia');
          if (elCapMcp) elCapMcp.style.opacity = cap?.mcp_compatible ? '1' : '0.4';
          if (elCapOpenapi) elCapOpenapi.style.opacity = cap?.openapi_spec ? '1' : '0.4';
          if (elCapEvents) elCapEvents.style.opacity = cap?.event_driven ? '1' : '0.4';
          if (elCapIdempotencia) elCapIdempotencia.style.opacity = cap?.idempotencia ? '1' : '0.4';
        } else {
          elAgentReadyCard.classList.add('hidden');
        }
      }

      // Populate Governance Fields (Ley 21.663 & Ley 21.719)
      const elCiber = document.getElementById('node-ciberseguridad');
      const elDespliegue = document.getElementById('node-despliegue');
      const elPdpBadge = document.getElementById('node-pdp-badge');
      const elDpoStatus = document.getElementById('node-dpo-status');
      const elRatStatus = document.getElementById('node-rat-status');
      const elPolStatus = document.getElementById('node-pol-status');

      if (elCiber) {
        const ciberMap: Record<string, string> = {
          operador_importancia_vital: 'OIV (Importancia Vital)',
          prestador_servicios_esenciales: 'PSE (Servicio Esencial)',
          organo_sector_publico: 'Órgano Sector Público',
          estandar: 'Estándar',
        };
        elCiber.textContent = ciberMap[node.calificacion_ciberseguridad || ''] || 'Sector Público';
      }

      if (elDespliegue) {
        const despMap: Record<string, string> = {
          nodo_perimetral_p2p: 'Nodo Perimetral P2P',
          nodo_centralizado: 'Nodo Centralizado',
          gateway_api: 'Gateway API',
          nodo_hibrido: 'Nodo Híbrido',
        };
        elDespliegue.textContent = despMap[node.tipo_despliegue_nodo || ''] || 'Nodo Perimetral P2P';
      }

      if (node.compliance_ley21719) {
        const cmp = node.compliance_ley21719;
        if (elPdpBadge) elPdpBadge.textContent = cmp.nivel_cumplimiento.toUpperCase();
        if (elDpoStatus) elDpoStatus.innerHTML = cmp.oficial_proteccion_datos ? '<span class="text-[#54b995]">✔ DPO</span>' : '<span class="text-[#e4b18e]">✖ DPO</span>';
        if (elRatStatus) elRatStatus.innerHTML = cmp.registro_actividades_tratamiento ? '<span class="text-[#54b995]">✔ RAT</span>' : '<span class="text-[#e4b18e]">✖ RAT</span>';
        if (elPolStatus) elPolStatus.innerHTML = cmp.politica_privacidad_actualizada ? '<span class="text-[#54b995]">✔ POL</span>' : '<span class="text-[#e4b18e]">✖ POL</span>';
      } else {
        if (elPdpBadge) elPdpBadge.textContent = 'EN ADECUACIÓN';
        if (elDpoStatus) elDpoStatus.textContent = 'DPO';
        if (elRatStatus) elRatStatus.textContent = 'RAT';
        if (elPolStatus) elPolStatus.textContent = 'POL';
      }

      // Populate Official Legal & Technical Documents (Clip section)
      const elDocsBadge = document.getElementById('node-docs-count-badge');
      const elDocsList = document.getElementById('node-docs-list');
      const docs = node.documentacion_oficial || [];

      if (elSummaryDocsText) {
        elSummaryDocsText.textContent = `${docs.length} ${docs.length === 1 ? 'adjunto oficial' : 'adjuntos oficiales'}`;
      }

      if (elDocsBadge) {
        elDocsBadge.textContent = `${docs.length} ${docs.length === 1 ? 'adjunto' : 'adjuntos'}`;
      }

      if (elDocsList) {
        elDocsList.innerHTML = '';
        if (docs.length === 0) {
          elDocsList.innerHTML = '<span class="text-[#94a3b8] italic text-[11px] block py-1">Sin expedientes jurídicos indexados aún</span>';
        } else {
          docs.forEach((doc) => {
            const item = document.createElement('div');
            item.className = 'p-2.5 rounded-lg bg-[#06234a] border border-[#1e3a5f] space-y-1 hover:border-[#54b995] transition-colors';
            
            const badgeType = doc.tipo.replace('_', ' ');
            item.innerHTML = `
              <div class="flex items-center justify-between gap-1 flex-wrap">
                <span class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-[#0b4aa2] text-[#54b995] border border-[#1d4d91]">
                  ${badgeType}
                </span>
                <span class="text-[10px] font-mono text-[#94a3b8]">${doc.ano || ''}</span>
              </div>
              <a href="${doc.url}" target="_blank" rel="noopener noreferrer" class="font-bold text-[#f7f5ef] hover:text-[#d7653b] text-xs leading-snug flex items-center gap-1 group mt-1">
                <span>${doc.titulo}</span>
                <svg class="w-3 h-3 text-[#94a3b8] group-hover:text-[#d7653b] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <p class="text-[11px] text-[#94a3b8] leading-relaxed pt-0.5">${doc.resumen}</p>
            `;
            elDocsList.appendChild(item);
          });
        }
      }

      // Populate flow preview list
      if (elFlowsList) {
        elFlowsList.innerHTML = '';
        const incoming = node.aristas_entrantes || [];
        const outgoing = node.aristas_salientes || [];

        if (incoming.length === 0 && outgoing.length === 0) {
          elFlowsList.innerHTML = '<span class="text-[#94a3b8] italic">Sin flujos registrados</span>';
        } else {
          incoming.forEach((inEdge) => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'w-full text-left flex items-center justify-between text-[11px] bg-[#06234a] hover:bg-[#0b4aa2] px-2 py-1.5 rounded border border-[#1e3a5f] hover:border-[#54b995] transition-colors cursor-pointer group';
            const label = inEdge.origen_sigla || inEdge.origen.toUpperCase();
            item.innerHTML = `
              <span class="text-[#54b995] group-hover:text-white font-bold">← Entrante de <strong>${label}</strong></span>
              <span class="text-[10px] text-[#94a3b8] font-mono">${inEdge.bus}</span>
            `;
            item.title = `Ver detalle del flujo ${inEdge.id}`;
            item.addEventListener('click', () => {
              const controller = (window as unknown as { __graphController?: { cy?: { getElementById: (id: string) => { length: number } }; selectEdge: (edge: unknown) => void } }).__graphController;
              if (controller?.cy) {
                const edgeElem = controller.cy.getElementById(inEdge.id);
                if (edgeElem.length > 0) {
                  controller.selectEdge(edgeElem);
                }
              }
            });
            elFlowsList.appendChild(item);
          });

          outgoing.forEach((outEdge) => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'w-full text-left flex items-center justify-between text-[11px] bg-[#06234a] hover:bg-[#0b4aa2] px-2 py-1.5 rounded border border-[#1e3a5f] hover:border-[#e4b18e] transition-colors cursor-pointer group';
            const label = outEdge.destino_sigla || outEdge.destino.toUpperCase();
            item.innerHTML = `
              <span class="text-[#e4b18e] group-hover:text-white font-bold">→ Hacia <strong>${label}</strong></span>
              <span class="text-[10px] text-[#94a3b8] font-mono">${outEdge.bus}</span>
            `;
            item.title = `Ver detalle del flujo ${outEdge.id}`;
            item.addEventListener('click', () => {
              const controller = (window as unknown as { __graphController?: { cy?: { getElementById: (id: string) => { length: number } }; selectEdge: (edge: unknown) => void } }).__graphController;
              if (controller?.cy) {
                const edgeElem = controller.cy.getElementById(outEdge.id);
                if (edgeElem.length > 0) {
                  controller.selectEdge(edgeElem);
                }
              }
            });
            elFlowsList.appendChild(item);
          });
        }
      }
    }

    function renderEdgeSheet(edge: EdgeDrawerPayload) {
      if (!emptyState || !nodeView || !edgeView || !typeBadge || !statusBadge) return;

      emptyState.classList.add('hidden');
      nodeView.classList.add('hidden');
      edgeView.classList.remove('hidden');

      typeBadge.textContent = 'Flujo de Interoperabilidad';

      const hasGap = Boolean(edge.brecha_observada && edge.brecha_observada.trim().length > 5);
      if (hasGap) {
        statusBadge.classList.remove('hidden');
      } else {
        statusBadge.classList.add('hidden');
      }

      // Populate Edge Fields
      const elOrigen = document.getElementById('edge-origen-sigla');
      const elDestino = document.getElementById('edge-destino-sigla');
      const elDataType = document.getElementById('edge-data-type');
      const elBus = document.getElementById('edge-bus');
      const elProtocol = document.getElementById('edge-protocol');
      const elApertura = document.getElementById('edge-apertura');
      const elFrecuencia = document.getElementById('edge-frecuencia');
      const elBaseLegal = document.getElementById('edge-base-legal');
      const elGapContainer = document.getElementById('edge-gap-container');
      const elGapText = document.getElementById('edge-gap-text');
      const elLink = document.getElementById('edge-source-link') as HTMLAnchorElement | null;

      if (elOrigen) elOrigen.textContent = edge.origen_sigla || edge.origen_id.toUpperCase();
      if (elDestino) elDestino.textContent = edge.destino_sigla || edge.destino_id.toUpperCase();
      if (elDataType) elDataType.textContent = edge.tipo_dato;
      if (elBus) elBus.textContent = edge.plataforma_o_bus;
      if (elProtocol) elProtocol.textContent = edge.estandar_o_protocolo;
      if (elApertura) elApertura.textContent = edge.nivel_apertura;
      if (elFrecuencia) elFrecuencia.textContent = edge.frecuencia_actualizacion;
      if (elBaseLegal) elBaseLegal.textContent = edge.base_legal || 'Ley N° 21.180';

      const elCanalBadge = document.getElementById('edge-canal-badge');
      const elMadurezBadge = document.getElementById('edge-madurez-badge');
      const elThemeBadge = document.getElementById('edge-theme-badge');
      const elProcesoCiudadano = document.getElementById('edge-proceso-ciudadano');
      const elProcesoBloqueado = document.getElementById('edge-proceso-bloqueado');

      const themeLabels: Record<string, string> = {
        identidad_ciudadana: '🆔 Identidad y ClaveÚnica',
        educacion_becas: '🎓 Educación y Becas',
        salud_seguridad_social: '🏥 Salud y Licencias',
        vivienda_urbanismo: '🏠 Vivienda y Bienes Raíces',
        trabajo_pensiones: '💼 Trabajo y Pensiones',
        proteccion_social: '👥 Protección Social (RSH)',
        finanzas_tributario: '💰 Impuestos y Pymes',
        justicia_seguridad: '⚖️ Justicia y Seguridad',
        transporte_movilidad: '🚗 Transporte y Circulación',
      };

      if (elThemeBadge) {
        const themeKey = edge.eje_tematico || 'identidad_ciudadana';
        elThemeBadge.textContent = themeLabels[themeKey] || 'Sector Público';
      }

      if (elProcesoCiudadano) {
        elProcesoCiudadano.textContent = edge.proceso_ciudadano || `Tramitación y verificación oficial entre ${edge.origen_sigla} y ${edge.destino_sigla}`;
      }

      if (elProcesoBloqueado) {
        elProcesoBloqueado.textContent = edge.proceso_bloqueado_en_silo || 'El ciudadano debe solicitar certificados físicos o presenciales para acreditar el trámite.';
      }

      if (elCanalBadge) {
        const canal = edge.canal || (edge.plataforma_o_bus.includes('PISEE') ? 'PISEE' : edge.plataforma_o_bus.includes('Manual') ? 'Manual' : 'Convenio');
        elCanalBadge.textContent = `Canal: ${canal}`;
      }
      if (elMadurezBadge) {
        const mad = edge.madurez_tecnica || (edge.estandar_o_protocolo.includes('REST') ? 'realtime' : edge.estandar_o_protocolo.includes('SFTP') ? 'batch' : 'manual');
        elMadurezBadge.textContent = mad === 'realtime' ? '⚡ API Tiempo Real' : mad === 'batch' ? '📦 Lotes / SFTP' : '📄 Documental / Manual';
      }

      // Populate Data Protection / Privacy Fields (Ley 21.719)
      const elPrivacyCard = document.getElementById('edge-privacy-card');
      const elEipdBadge = document.getElementById('edge-eipd-badge');
      const elBaseLicitud = document.getElementById('edge-base-licitud');
      const elCategoriaDatos = document.getElementById('edge-categoria-datos');

      if (elPrivacyCard) {
        if (edge.involucra_datos_personales) {
          elPrivacyCard.classList.remove('hidden');
          if (elEipdBadge) {
            if (edge.requiere_eipd) {
              elEipdBadge.textContent = 'EIPD: OBLIGATORIA (Art. 21)';
              elEipdBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-bold font-mono bg-[#be123c]/20 text-[#fca5a5] border border-[#be123c]/40';
            } else {
              elEipdBadge.textContent = 'EIPD: No requerida';
              elEipdBadge.className = 'px-1.5 py-0.5 rounded text-[9px] font-bold font-mono bg-[#041a37] text-[#54b995] border border-[#1e3a5f]';
            }
          }
          if (elBaseLicitud) {
            elBaseLicitud.textContent = (edge.base_licitud || 'obligacion_legal').replace(/_/g, ' ');
          }
          if (elCategoriaDatos) {
            elCategoriaDatos.textContent = (edge.categoria_datos_personales && edge.categoria_datos_personales.length > 0)
              ? edge.categoria_datos_personales.map((c) => c.replace(/_/g, ' ')).join(', ')
              : 'identificatorios';
          }
        } else {
          elPrivacyCard.classList.add('hidden');
        }
      }

      if (elGapContainer && elGapText) {
        if (hasGap) {
          elGapContainer.classList.remove('hidden');
          elGapText.textContent = edge.brecha_observada;
        } else {
          elGapContainer.classList.add('hidden');
        }
      }

      if (elLink) {
        if (edge.fuente_oficial_url && edge.fuente_oficial_url !== '#') {
          elLink.href = edge.fuente_oficial_url;
          elLink.title = `Consultar fuente oficial: ${edge.fuente_oficial_url}`;
          elLink.classList.remove('hidden');
        } else {
          elLink.removeAttribute('href');
          elLink.classList.add('hidden');
        }
      }

      const elEdgeReportLink = document.getElementById('edge-report-update-link') as HTMLAnchorElement | null;
      if (elEdgeReportLink) {
        const origenLabel = edge.origen_sigla || edge.origen_id.toUpperCase();
        const destinoLabel = edge.destino_sigla || edge.destino_id.toUpperCase();
        const issueTitle = encodeURIComponent(`[Actualización de Flujo] ${origenLabel} -> ${destinoLabel} (${edge.id})`);
        const issueBody = encodeURIComponent(
          `## Solicitud de Actualización de Flujo con Evidencia\n\n` +
          `- **Flujo ID:** \`${edge.id}\`\n` +
          `- **Origen:** ${origenLabel} (${edge.origen_nombre})\n` +
          `- **Destino:** ${destinoLabel} (${edge.destino_nombre})\n` +
          `- **Protocolo Actual Registrado:** ${edge.estandar_o_protocolo} (${edge.plataforma_o_bus})\n\n` +
          `### 1. Nuevo Estándar o Canal Implementado\n` +
          `(Indique si migró de SFTP/SOAP a REST/JSON sobre Red de Nodos DS N° 12/2023)\n\n` +
          `### 2. Evidencia Oficial Verificable (Obligatorio)\n` +
          `- **Resolución Exenta / Convenio en Gestor de Acuerdos SGD:** \n` +
          `- **Documentación Técnica / Swagger / Catálogo SGD:** \n`
        );
        elEdgeReportLink.href = `https://github.com/evegat/interoperabilidad-estado-chileno/issues/new?title=${issueTitle}&body=${issueBody}`;
      }
    }

    // Minuta EvalTI Handler
    let currentNodePayload: NodeDrawerPayload | null = null;
    window.addEventListener('selection-changed', ((e: CustomEvent<SelectionEventDetail>) => {
      if (e.detail?.type === 'node') {
        currentNodePayload = e.detail.payload;
      }
    }) as EventListener);

    const btnMinuta = document.getElementById('btn-generate-evalti-minuta');
    const originalBtnHtml = btnMinuta ? btnMinuta.innerHTML : '';
    let copyFeedbackTimer: ReturnType<typeof setTimeout> | null = null;

    btnMinuta?.addEventListener('click', () => {
      if (!currentNodePayload) return;
      const n = currentNodePayload;
      const imi = n.indice_madurez_interoperabilidad || 0;
      const lvl = n.nivel_madurez_interoperabilidad || 1;

      const minutaText = [
        `# MINUTA TÉCNICA DE BRECHA DE INTEROPERABILIDAD (JUSTIFICACIÓN EVALTI / DIPRES)`,
        `**Organismo:** ${n.nombre} (${n.sigla})`,
        `**Tipología:** ${n.tipo.toUpperCase()} | Dependencia: ${n.dependencia}`,
        `**Marco Jurídico Mandante:** Ley N° 21.180 (Transformación Digital del Estado) y DS N° 12/2023 MinSegpres (Norma Técnica de Interoperabilidad)`,
        `**Fecha de Emisión:** ${new Date().toLocaleDateString('es-CL')}`,
        `**Fuente de Auditoría:** Laboratorio GovTech evegat.cl (Observatorio de Interoperabilidad del Estado)`,
        ``,
        `---`,
        `## 1. Diagnóstico de Conexión Digital (Ley 21.180 / DS N° 12/2023)`,
        `- **Nivel de Conexión Digital:** ${imi}% (${imi} / 100 puntos)`,
        `- **Nivel Normativo:** Nivel ${lvl}`,
        `- **Sello Agent-Ready (IA):** ${n.agent_ready ? 'Cumple (4/4 checks)' : 'No Habilitado (Requiere OpenAPI 3.1 & Nodos Distribuidos)'}`,
        `- **Flujos Totales Auditados:** ${n.total_conexiones} (${n.in_degree} entrantes, ${n.out_degree} salientes)`,
        ``,
        `## 2. Artículos Vulnerados o Pendientes de Adecuación (DS N° 12/2023 MinSegpres)`,
        `- **Art. 4 (Arquitectura Distribuida):** Debe implementar y operar un Nodo de Interoperabilidad propio o delegado para desacoplarse de transferencias bilaterales directas.`,
        `- **Art. 11 (Catálogo de Servicios):** Obligación de registrar metadatos, esquemas de datos y contratos en el Catálogo de Interoperabilidad de la SGD.`,
        `- **Art. 13 (Gestor de Acuerdos):** Todo intercambio interinstitucional debe formalizarse electrónicamente mediante el Gestor de Acuerdos centralizado.`,
        `- **Art. 16 (Gestor de Autorizaciones y Consentimiento):** Obligación de consulta al gestor común para resguardo de la Ley N° 21.719 de Protección de Datos Personales.`,
        ``,
        `## 3. Justificación de Inversión Tecnológica (Para Formulario EvalTI)`,
        `El proyecto de inversión TI postulado es de carácter estrictamente habilitante para el cumplimiento de los hitos perentorios de la Ley N° 21.180. Su ejecución reemplaza transferencias por archivos planos y procesos manuales por consumo seguro en tiempo de ejecución (APIs REST mTLS sobre la Red de Interoperabilidad), mitigando el riesgo de observaciones por parte de la Contraloría General de la República (CGR).`,
        ``,
        `## 4. Imputación Presupuestaria Sugerida (Ley de Presupuestos / DAF - DIPRES)`,
        `- **Subtítulo 29 (Adquisición de Activos No Financieros):**`,
        `  - **Ítem 06 (Equipos Informáticos):** Infraestructura de soporte o appliances de seguridad para despliegue de Nodo de Interoperabilidad institucional.`,
        `  - **Ítem 07 (Programas Informáticos):** Desarrollo, licenciamiento y refactorización de conectores API REST/JSON (OpenAPI 3.1), homologación semántica para el Gestor de Códigos e integración con el Gestor de Consentimiento (Ley N° 21.719).`,
        `- **Mecanismo de Contratación Sugerido:** Catálogo de Compras Públicas (ChileCompra) / Convenio Marco de Desarrollo y Mantención de Software e Interoperabilidad o Licitación Pública sujeta a visación técnica EvalTI.`,
        ``,
        `---`,
        `*Generado automáticamente desde https://interoperabilidadpublica.evegat.cl · Auditoría y Consultoría GovTech: Eduardo Vega Toledo (evegat.cl)*`
      ].join('\n');

      navigator.clipboard.writeText(minutaText).then(() => {
        if (copyFeedbackTimer) clearTimeout(copyFeedbackTimer);
        btnMinuta.innerHTML = `
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-emerald-300 font-bold">¡Minuta de ${n.sigla} Copiada!</span>
        `;
        copyFeedbackTimer = setTimeout(() => {
          btnMinuta.innerHTML = originalBtnHtml;
        }, 3000);
      }).catch(() => {
        alert('Copia el siguiente texto para tu minuta EvalTI:\n\n' + minutaText);
      });
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initDetailDrawer);
    } else {
      initDetailDrawer();
    }
  }
</script>
