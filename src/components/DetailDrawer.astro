---
---

<aside
  id="detail-drawer"
  class="fixed inset-y-0 right-0 z-40 w-full sm:w-[440px] bg-[#06234a]/98 backdrop-blur-xl border-l border-[#1e3a5f] shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out"
  aria-label="Panel de Detalles Técnicos"
>
  <!-- Drawer Header -->
  <div class="px-5 py-3.5 border-b border-[#1e3a5f] flex items-center justify-between bg-[#031329]/90">
    <div class="flex items-center space-x-2">
      <span id="drawer-type-badge" class="px-2 py-0.5 rounded text-[11px] font-extrabold uppercase tracking-wider bg-[#0b4aa2] text-[#54b995] border border-[#1d4d91]">
        Ficha Técnica
      </span>
      <span id="drawer-status-badge" class="hidden px-2 py-0.5 rounded text-[11px] font-bold bg-[#d7653b]/20 text-[#e4b18e] border border-[#d7653b]/40">
        Con Brecha Observada
      </span>
    </div>
    <button
      type="button"
      id="drawer-close"
      class="text-[#94a3b8] hover:text-white p-1 rounded-md hover:bg-[#0b4aa2] transition-colors focus:outline-none"
      title="Cerrar panel"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Scrollable Content Body -->
  <div id="drawer-content" class="flex-1 overflow-y-auto p-5 space-y-4 text-xs text-[#94a3b8]">
    <!-- Placeholder / Empty State -->
    <div id="drawer-empty-state" class="h-full flex flex-col items-center justify-center text-center p-6 text-[#94a3b8]">
      <div class="w-14 h-14 rounded-full bg-[#0b4aa2]/60 border border-[#1e3a5f] flex items-center justify-center mb-3">
        <svg class="w-7 h-7 text-[#54b995]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="font-bold text-sm text-[#f7f5ef]">Ningún elemento seleccionado</p>
      <p class="text-xs text-[#94a3b8] mt-1 max-w-xs leading-relaxed">
        Haz click en un nodo institucional o en una arista de flujo para consultar su ficha técnica, protocolos y marco normativo.
      </p>
    </div>

    <!-- Node Technical Sheet Container -->
    <div id="drawer-node-view" class="hidden space-y-3.5">
      <div>
        <div class="flex items-baseline justify-between">
          <span id="node-sigla" class="text-2xl font-black text-white tracking-tight">SIGLA</span>
          <span id="node-id" class="text-[11px] font-mono text-[#94a3b8] bg-[#031329] border border-[#1e3a5f] px-2 py-0.5 rounded">id</span>
        </div>
        <h2 id="node-nombre" class="text-sm font-bold text-[#f7f5ef] mt-1 leading-snug">
          Nombre completo de la institución
        </h2>
        <!-- Immediate Visual Badges: Attachments & IMI -->
        <div class="flex items-center gap-2 mt-2 flex-wrap">
          <span id="node-summary-docs-badge" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#0b4aa2] text-[#54b995] border border-[#1d4d91]" title="Expediente de documentación oficial trazable">
            <svg class="w-3 h-3 text-[#54b995]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
            </svg>
            <span id="node-summary-docs-text">0 adjuntos</span>
          </span>
          <span id="node-summary-imi-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-[#031329] text-[#e4b18e] border border-[#1e3a5f]">
            Digital: 0%
          </span>
          <span id="node-theme-badge" class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-[#38bdf8]/15 text-[#38bdf8] border border-[#38bdf8]/30">
            Sector
          </span>
        </div>

        <!-- Silo Warning Banner (visible only if es_silo) -->
        <div id="node-silo-banner" class="hidden mt-2 p-2.5 rounded-lg bg-[#9f1239]/20 border border-[#be123c]/50 text-xs space-y-1">
          <div class="flex items-center gap-1.5 font-black text-[#fca5a5]">
            <span>⚠️</span>
            <span>ORGANISMO EN SILO ESTATAL (0% CONECTADO)</span>
          </div>
          <p class="text-[11px] text-[#fca5a5]/90 leading-tight">
            Esta institución no registra interfaces de interoperabilidad en la Red de Nodos ni APIs en el Catálogo SGD. Sus trámites dependen de oficios en papel, planillas manuales o presencia física del ciudadano.
          </p>
        </div>
      </div>

      <!-- Attributes Grid -->
      <div class="grid grid-cols-2 gap-2 text-xs">
        <div class="bg-[#031329] p-2.5 rounded-lg border border-[#1e3a5f]">
          <span class="block text-[#94a3b8] text-[10px] uppercase font-bold tracking-wider">Tipología</span>
          <span id="node-tipo" class="font-bold text-[#54b995] capitalize mt-0.5 block">-</span>
        </div>
        <div class="bg-[#031329] p-2.5 rounded-lg border border-[#1e3a5f]">
          <span class="block text-[#94a3b8] text-[10px] uppercase font-bold tracking-wider">Dependencia</span>
          <span id="node-dependencia" class="font-bold text-[#f7f5ef] truncate block mt-0.5">-</span>
        </div>
        <div class="bg-[#031329] p-2.5 rounded-lg border border-[#1e3a5f]">
          <span class="block text-[#94a3b8] text-[10px] uppercase font-bold tracking-wider">Madurez Digital</span>
          <span id="node-madurez" class="font-bold text-[#54b995] capitalize mt-0.5 block">-</span>
        </div>
        <div class="bg-[#031329] p-2.5 rounded-lg border border-[#1e3a5f]">
          <span class="block text-[#94a3b8] text-[10px] uppercase font-bold tracking-wider">Ley N° 21.180</span>
          <span id="node-ley" class="font-bold text-[#e4b18e] capitalize mt-0.5 block">-</span>
        </div>
      </div>

      <!-- Nivel de Conexión Digital (Ley 21.180 / DS 12) Card -->
      <div id="node-imi-card" class="bg-[#031329] p-3 rounded-lg border border-[#1e3a5f] space-y-2">
        <div class="flex items-center justify-between">
          <span class="block text-[10px] font-extrabold text-[#94a3b8] uppercase tracking-wider">Nivel de Conexión Digital</span>
          <span id="node-imi-badge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-[#0b4aa2] text-[#54b995] border border-[#1d4d91]">
            Nivel 4: Conectado por API
          </span>
        </div>
        <div class="flex items-baseline justify-between text-xs">
          <span id="node-imi-level-desc" class="text-[#f1f5f9] font-semibold text-[11px]">Conectado por API</span>
          <span id="node-imi-score" class="font-black text-sm text-[#54b995]">0% (0 / 100 pts)</span>
        </div>
        <!-- Progress bar -->
        <div class="w-full bg-[#06234a] h-2 rounded-full overflow-hidden border border-[#1e3a5f]">
          <div id="node-imi-bar" class="h-full bg-gradient-to-r from-[#d7653b] via-[#c5a75a] via-[#54b995] to-[#a78bfa] rounded-full transition-all duration-500" style="width: 50%;"></div>
        </div>
      </div>

      <!-- Desglose Metodológico de Conexión Digital (5 Factores de 20 pts) -->
      <div id="node-breakdown-card" class="bg-[#031329] p-3 rounded-lg border border-[#1e3a5f] space-y-2.5">
        <div class="flex items-center justify-between border-b border-[#1e3a5f] pb-1.5">
          <div class="flex items-center gap-1.5">
            <span class="text-xs">📐</span>
            <span class="text-[10px] font-extrabold text-[#f7f5ef] uppercase tracking-wider">
              Desglose Metodológico (5 Factores Auditables)
            </span>
          </div>
          <span class="text-[9px] font-mono text-[#54b995] font-bold">5 × 20 pts = 100%</span>
        </div>
        <p class="text-[10px] text-[#94a3b8] leading-tight">
          Puntaje auditable conforme a la Ley N° 21.180, DS N° 12/2023, Ley N° 21.719 y Ley N° 21.663:
        </p>
        
        <div class="space-y-2" id="node-breakdown-factors">
          <!-- Factor 1: Canal Oficial -->
          <div class="space-y-1 bg-[#06234a]/60 p-2 rounded border border-[#1e3a5f]/60">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-[#cbd5e1] font-semibold flex items-center gap-1">
                <span>1. Canal Oficial (DS 12 Art. 4)</span>
              </span>
              <span id="factor-canal-score" class="font-mono font-bold text-[#54b995]">0 / 20 pts</span>
            </div>
            <div class="w-full bg-[#031329] h-1.5 rounded-full overflow-hidden border border-[#1e3a5f]/50">
              <div id="factor-canal-bar" class="h-full bg-[#54b995] rounded-full transition-all" style="width: 0%;"></div>
            </div>
            <span id="factor-canal-desc" class="block text-[10px] text-[#94a3b8]">-</span>
          </div>

          <!-- Factor 2: Protocolo REST -->
          <div class="space-y-1 bg-[#06234a]/60 p-2 rounded border border-[#1e3a5f]/60">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-[#cbd5e1] font-semibold flex items-center gap-1">
                <span>2. Protocolo REST (DS 12 Art. 8)</span>
              </span>
              <span id="factor-proto-score" class="font-mono font-bold text-[#38bdf8]">0 / 20 pts</span>
            </div>
            <div class="w-full bg-[#031329] h-1.5 rounded-full overflow-hidden border border-[#1e3a5f]/50">
              <div id="factor-proto-bar" class="h-full bg-[#38bdf8] rounded-full transition-all" style="width: 0%;"></div>
            </div>
            <span id="factor-proto-desc" class="block text-[10px] text-[#94a3b8]">-</span>
          </div>

          <!-- Factor 3: Gobernanza SGD -->
          <div class="space-y-1 bg-[#06234a]/60 p-2 rounded border border-[#1e3a5f]/60">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-[#cbd5e1] font-semibold flex items-center gap-1">
                <span>3. Gobernanza SGD (DS 12 Art. 13)</span>
              </span>
              <span id="factor-gob-score" class="font-mono font-bold text-[#c5a75a]">0 / 20 pts</span>
            </div>
            <div class="w-full bg-[#031329] h-1.5 rounded-full overflow-hidden border border-[#1e3a5f]/50">
              <div id="factor-gob-bar" class="h-full bg-[#c5a75a] rounded-full transition-all" style="width: 0%;"></div>
            </div>
            <span id="factor-gob-desc" class="block text-[10px] text-[#94a3b8]">-</span>
          </div>

          <!-- Factor 4: Once-Only -->
          <div class="space-y-1 bg-[#06234a]/60 p-2 rounded border border-[#1e3a5f]/60">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-[#cbd5e1] font-semibold flex items-center gap-1">
                <span>4. Once-Only (Ley 21.180 Art. 1°)</span>
              </span>
              <span id="factor-once-score" class="font-mono font-bold text-[#e4b18e]">0 / 20 pts</span>
            </div>
            <div class="w-full bg-[#031329] h-1.5 rounded-full overflow-hidden border border-[#1e3a5f]/50">
              <div id="factor-once-bar" class="h-full bg-[#e4b18e] rounded-full transition-all" style="width: 0%;"></div>
            </div>
            <span id="factor-once-desc" class="block text-[10px] text-[#94a3b8]">-</span>
          </div>

          <!-- Factor 5: Seguridad y Privacidad -->
          <div class="space-y-1 bg-[#06234a]/60 p-2 rounded border border-[#1e3a5f]/60">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-[#cbd5e1] font-semibold flex items-center gap-1">
                <span>5. Privacidad y Ciberseguridad (Ley 21.719/21.663)</span>
              </span>
              <span id="factor-sec-score" class="font-mono font-bold text-[#a78bfa]">0 / 20 pts</span>
            </div>
            <div class="w-full bg-[#031329] h-1.5 rounded-full overflow-hidden border border-[#1e3a5f]/50">
              <div id="factor-sec-bar" class="h-full bg-[#a78bfa] rounded-full transition-all" style="width: 0%;"></div>
            </div>
            <span id="factor-sec-desc" class="block text-[10px] text-[#94a3b8]">-</span>
          </div>
        </div>
      </div>

      <!-- Agent-Ready / IA Soberana Capabilities Card (shown when agent_ready) -->
      <div id="node-agent-ready-card" class="hidden bg-[#0c1829]/95 p-3 rounded-lg border border-[#3b82f6]/40 space-y-2.5 shadow-lg">
        <div class="flex items-center justify-between border-b border-[#1e3a5f] pb-1.5">
          <div class="flex items-center space-x-1.5">
            <span class="text-sm">🤖</span>
            <span class="font-extrabold text-[#93c5fd] uppercase tracking-wider text-[10px]">
              Capacidades para Agentes de IA (Agent-Ready)
            </span>
          </div>
          <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold bg-[#1d4ed8]/30 text-[#60a5fa] border border-[#2563eb]/50">
            N6 Soberano
          </span>
        </div>
        <div class="grid grid-cols-2 gap-1.5 text-[11px]" id="node-agent-caps-grid">
          <div class="flex items-center space-x-1.5 p-1.5 rounded bg-[#071324] border border-[#1e3a5f]" id="cap-mcp">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            <span class="text-[#e2e8f0]">MCP Tool Calling</span>
          </div>
          <div class="flex items-center space-x-1.5 p-1.5 rounded bg-[#071324] border border-[#1e3a5f]" id="cap-openapi">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            <span class="text-[#e2e8f0]">OpenAPI 3.1 Strict</span>
          </div>
          <div class="flex items-center space-x-1.5 p-1.5 rounded bg-[#071324] border border-[#1e3a5f]" id="cap-events">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            <span class="text-[#e2e8f0]">Event-Driven / SSE</span>
          </div>
          <div class="flex items-center space-x-1.5 p-1.5 rounded bg-[#071324] border border-[#1e3a5f]" id="cap-idempotencia">
            <span class="w-2 h-2 rounded-full bg-[#10b981]"></span>
            <span class="text-[#e2e8f0]">Idempotencia Segura</span>
          </div>
        </div>
        <div class="text-[10px] text-[#93c5fd]/80 pt-1 border-t border-[#1e3a5f]/60 flex items-center justify-between">
          <span>📜 Auditoría Criptográfica / Zero Human</span>
          <span class="font-mono text-[#60a5fa]">Ley 21.180</span>
        </div>
      </div>

      <!-- Ley N° 21.663 & Ley N° 21.719 Governance Card -->
      <div id="node-v3-governance-card" class="bg-[#031329] p-3 rounded-lg border border-[#1e3a5f] space-y-2">
        <div class="flex items-center justify-between border-b border-[#1e3a5f] pb-1.5">
          <span class="text-[10px] font-extrabold text-[#38bdf8] uppercase tracking-wider flex items-center gap-1.5">
            <span>🛡️</span> Gobernanza Ley 21.719 & Ley 21.663
          </span>
          <span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-[#0b4aa2] text-[#54b995] border border-[#1d4d91]">
            Marco 2026
          </span>
        </div>
        <div class="grid grid-cols-2 gap-1.5 text-[11px]">
          <div class="p-2 rounded bg-[#06234a] border border-[#1e3a5f]">
            <span class="text-[#94a3b8] block text-[10px] uppercase font-bold">Ciberseguridad (ANCI)</span>
            <span id="node-ciberseguridad" class="font-bold text-[#f7f5ef] block mt-0.5 truncate">-</span>
          </div>
          <div class="p-2 rounded bg-[#06234a] border border-[#1e3a5f]">
            <span class="text-[#94a3b8] block text-[10px] uppercase font-bold">Despliegue Nodo</span>
            <span id="node-despliegue" class="font-bold text-[#54b995] block mt-0.5 truncate">-</span>
          </div>
        </div>
        <div id="node-compliance-pdp" class="p-2 rounded bg-[#06234a] border border-[#1e3a5f] text-[10px] space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-bold text-[#cbd5e1]">Adecuación Datos Personales (APDP):</span>
            <span id="node-pdp-badge" class="px-1.5 py-0.5 rounded font-mono font-bold text-[#54b995] bg-[#54b995]/20">-</span>
          </div>
          <div class="grid grid-cols-3 gap-1 pt-1 text-center font-mono text-[9px]">
            <div id="node-dpo-status" class="p-1 rounded bg-[#031329] border border-[#1e3a5f] text-[#cbd5e1]">DPO</div>
            <div id="node-rat-status" class="p-1 rounded bg-[#031329] border border-[#1e3a5f] text-[#cbd5e1]">RAT</div>
            <div id="node-pol-status" class="p-1 rounded bg-[#031329] border border-[#1e3a5f] text-[#cbd5e1]">POLÍTICA</div>
          </div>
        </div>
      </div>

      <!-- Ecosystem Role -->
      <div class="bg-[#031329] p-3 rounded-lg border border-[#1e3a5f]">
        <span class="block text-[10px] font-extrabold text-[#94a3b8] uppercase tracking-wider mb-1">Rol en el Ecosistema</span>
        <p id="node-rol" class="text-xs text-[#f1f5f9] leading-relaxed"></p>
      </div>

      <!-- Degree Connections -->
      <div class="bg-[#031329] p-3 rounded-lg border border-[#1e3a5f] space-y-2">
        <div class="flex items-center justify-between text-xs border-b border-[#1e3a5f] pb-1.5">
          <span class="font-bold text-[#f7f5ef] uppercase tracking-wider text-[10px]">Topología de Flujos</span>
          <span id="node-total-conexiones" class="text-[#54b995] font-black">0 conexiones</span>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <div class="bg-[#06234a] p-2 rounded border border-[#1e3a5f]">
            <span class="text-[#94a3b8] block text-[10px] uppercase font-bold">Entrantes (In)</span>
            <span id="node-in-degree" class="text-base font-black text-white">0</span>
          </div>
          <div class="bg-[#06234a] p-2 rounded border border-[#1e3a5f]">
            <span class="text-[#94a3b8] block text-[10px] uppercase font-bold">Salientes (Out)</span>
            <span id="node-out-degree" class="text-base font-black text-white">0</span>
          </div>
        </div>
        <div id="node-flows-list" class="space-y-1 mt-2 text-xs">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Official Legal & Technical Documents (Clip Section) -->
      <div id="node-docs-section" class="bg-[#031329] p-3 rounded-lg border border-[#1e3a5f] space-y-2.5">
        <div class="flex items-center justify-between border-b border-[#1e3a5f] pb-1.5">
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-[#d7653b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
            </svg>
            <span class="font-extrabold text-[#f7f5ef] uppercase tracking-wider text-[10px]">📎 Documentación Oficial y Respaldo Legal</span>
          </div>
          <span id="node-docs-count-badge" class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-[#0b4aa2] text-[#54b995] border border-[#1d4d91]">
            0 adjuntos
          </span>
        </div>
        <div id="node-docs-list" class="space-y-2 text-xs">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Action Buttons: Portal, Minuta EvalTI & Derecho a Réplica -->
      <div class="space-y-2 pt-1">
        <button
          type="button"
          id="btn-generate-evalti-minuta"
          class="w-full inline-flex items-center justify-center space-x-2 px-4 py-2.5 bg-[#d7653b] hover:bg-[#c95631] text-white rounded-lg font-black text-xs shadow-lg transition-colors focus:outline-none"
          title="Generar minuta técnica estructurada para justificación presupuestaria ante DIPRES y SGD (EvalTI)"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Generar Minuta de Brecha (EvalTI)</span>
        </button>

        <a
          id="node-report-update-link"
          href="https://github.com/evegat/interoperabilidad-estado-chileno/issues/new"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center space-x-2 px-4 py-2 bg-[#041a37] hover:bg-[#0b4aa2] text-[#54b995] hover:text-white rounded-lg font-bold text-[11px] border border-[#1d4d91] hover:border-[#54b995] transition-colors"
          title="Derecho a Réplica Institucional: Enviar evidencia oficial (Resolución / Swagger / Convenio) para actualizar este nodo"
        >
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Reportar Actualización con Evidencia (PR / Issue)</span>
        </a>

        <a
          id="node-website-link"
